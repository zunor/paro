SELECT name, kind, metric_unit, metric_value > 0 AS observed
FROM paro_optimizers()
WHERE name IN (
    'join_elimination',
    'memo_group_count',
    'memo_logical_expression_count',
    'memo_physical_expression_count'
)
ORDER BY kind, name;
name	kind	metric_unit	observed
