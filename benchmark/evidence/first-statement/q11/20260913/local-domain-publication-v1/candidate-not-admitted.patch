+                    allocation.write_bytes(b"paro.transformed-group.v3");
                     allocation.write_fingerprint(logical_identity);
                     allocation.write_u64(node_context.0 as u64);
+                    // Reuse compares the ordered input groups, not just the
+                    // operator shell. A restricted view is a different input
+                    // even when its columns and parent operator are unchanged.
+                    // Canonicalize exactly as the reuse lookup above does;
+                    // frontier revisions and physical consumers are not inputs
+                    // to this logical allocation identity.
+                    allocation.write_u64(key.children.len() as u64);
+                    for child in &key.children {
+                        allocation.write_u64(memo.canonical_group(*child).0 as u64);
+                    }
                     // An operator shell can expose different output column
                     // identities (notably a freshly rebound Projection).
                     // Admission must name the same contract as group reuse.
diff --git a/crates/optimizer/src/cascades/planner/transformation/native_domain_tests.rs b/crates/optimizer/src/cascades/planner/transformation/native_domain_tests.rs
index 0c850fe8..59a63c42 100644
--- a/crates/optimizer/src/cascades/planner/transformation/native_domain_tests.rs
+++ b/crates/optimizer/src/cascades/planner/transformation/native_domain_tests.rs
@@ -951,3 +951,185 @@ fn production_selected_binding_derives_mixed_aggregate_domain_through_constant_p
         "aggregate result predicate must remain above aggregation"
     );
 }
+
+#[test]
+fn production_domain_closures_publish_distinct_restricted_children() {
+    let constant = |value| {
+        Expression::Constant(
+            ConstantExpression::new(Value::Integer(value), LogicalType::Integer).into(),
+        )
+    };
+    let branch =
+        |value| {
+            let rows = [10, 20]
+                .into_iter()
+                .flat_map(|y| {
+                    [1, 2, 3]
+                        .into_iter()
+                        .map(move |x| vec![constant(x), constant(y)])
+                })
+                .collect();
+            let input = OwnedLogicalPlan::synthetic(LogicalOperator::ExpressionGet(
+                paro_planner::operator::ExpressionGet::new(
+                    0,
+                    rows,
+                    vec!["x".into(), "y".into()],
+                    vec![LogicalType::Integer; 2],
+                ),
+            ));
+            let restricted = OwnedLogicalPlan::synthetic(LogicalOperator::Filter(Filter::new(
+                input,
+                vec![Expression::Comparison(
+                    ComparisonExpression::new(ComparisonType::Equal, column(0, 1), constant(value))
+                        .into(),
+                )],
+            )));
+            let aggregate =
+                OwnedLogicalPlan::synthetic(LogicalOperator::Aggregate(Box::new(Aggregate::new(
+                    10,
+                    11,
+                    12,
+                    restricted,
+                    vec![column(0, 0)],
+                    vec![],
+                    vec![],
+                    vec![],
+                ))));
+            let projection = OwnedLogicalPlan::synthetic(LogicalOperator::Projection(
+                Projection::new(20, aggregate, vec![column(10, 0)]),
+            ));
+            OwnedLogicalPlan::synthetic(LogicalOperator::Filter(Filter::new(
+                projection,
+                vec![equal(20, 0)],
+            )))
+        };
+    let plan = OwnedLogicalPlan::synthetic(LogicalOperator::SetOperation(SetOperation::union(
+        30,
+        branch(10),
+        branch(20),
+        true,
+        vec![LogicalType::Integer],
+    )));
+    let (mut engine, state, root) = frozen_selected(plan);
+    assert_ne!(
+        root.children[0].reference.group,
+        root.children[1].reference.group
+    );
+    let rule = PlannerTransformationRule {
+        transformation: PlannerTransformation::PredicateTransfer,
+        planner_state: state.clone(),
+    };
+    let bindings = rule
+        .selected_quality_bindings(engine.memo(), &root)
+        .unwrap();
+    assert_eq!(
+        bindings.len(),
+        2,
+        "both selected branches need a domain closure"
+    );
+    let arena_before = state.read().unwrap().staging_arena.len();
+    let mut published = Vec::new();
+    for (index, binding) in bindings.iter().enumerate() {
+        if index == 1 {
+            let groups_before = engine.memo().group_count();
+            let payloads_before = state.read().unwrap().payloads.logical.len();
+            let mut context = TransformContext::new(engine.memo_mut(), binding.root_group());
+            let outputs = rule
+                .apply_binding(binding, &mut context)
+                .expect("second selected closure must stage before rollback");
+            assert_eq!(outputs.len(), 1);
+            assert!(
+                context.memo().group_count() > groups_before,
+                "rollback must exercise newly allocated child groups"
+            );
+            context.rollback().unwrap();
+            assert_eq!(engine.memo().group_count(), groups_before);
+            assert_eq!(
+                state.read().unwrap().payloads.logical.len(),
+                payloads_before
+            );
+        }
+        let mut context = TransformContext::new(engine.memo_mut(), binding.root_group());
+        let outputs = rule
+            .apply_binding(binding, &mut context)
+            .unwrap_or_else(|error| {
+                panic!("closure {} failed production staging: {error}", index + 1)
+            });
+        assert_eq!(
+            outputs.len(),
+            1,
+            "each closure must return its complete root"
+        );
+        for output in outputs {
+            let root = context
+                .memo_mut()
+                .insert_logical_with_operator_encoding(
+                    output.target_group,
+                    output.key,
+                    output.payload,
+                    output.proof,
+                    output.operator_encoding.unwrap(),
+                )
+                .unwrap();
+            published.push(root);
+        }
+        context.commit().unwrap();
+    }
+    assert_eq!(
+        state.read().unwrap().staging_arena.len(),
+        arena_before,
+        "both closures must use native production, without owned settlement"
+    );
+    let aggregates = published
+        .iter()
+        .map(|&root| engine.memo().logical_expr(root).unwrap().key.children[0])
+        .collect::<Vec<_>>();
+    assert_ne!(
+        aggregates[0], aggregates[1],
+        "different restricted inputs need distinct aggregate chains"
+    );
+    let restricted = aggregates
+        .iter()
+        .map(|&group| {
+            let logical = engine.memo().group(group).unwrap().logical_exprs()[0];
+            let expression = engine.memo().logical_expr(logical).unwrap();
+            assert!(matches!(
+                state.read().unwrap().payloads.logical[expression.payload.index()]
+                    .semantic_template
+                    .operator,
+                LogicalOperator::Aggregate(_)
+            ));
+            expression.key.children[0]
+        })
+        .collect::<Vec<_>>();
+    assert_ne!(
+        restricted[0], restricted[1],
+        "aggregates must consume their distinct restricted child groups"
+    );
+
+    let groups_before = engine.memo().group_count();
+    for binding in &bindings {
+        let mut context = TransformContext::new(engine.memo_mut(), binding.root_group());
+        let outputs = rule.apply_binding(binding, &mut context).unwrap();
+        for output in outputs {
+            assert!(
+                context
+                    .memo()
+                    .logical_expr_for_structural_key(
+                        output.target_group,
+                        &output.key,
+                        output.operator_encoding.as_deref().unwrap(),
+                    )
+                    .is_some(),
+                "replayed closure must resolve to its published root"
+            );
+        }
+        assert_eq!(
+            context.memo().group_count(),
+            groups_before,
+            "replaying an identical selected binding must reuse its child groups"
+        );
+        context.rollback().unwrap();
+    }
+    assert_eq!(state.read().unwrap().staging_arena.len(), arena_before);
+}
