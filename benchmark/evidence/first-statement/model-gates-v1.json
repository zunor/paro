{
  "schema_version": 1,
  "manifest_id": "first-statement-model-gates-v1",
  "registered_at": "2026-09-10",
  "status": "registered_not_admitted",
  "purpose": "Pre-register conditional-statistics and cost-model acceptance before Q11 calibration",
  "scope": {
    "query_family": "TPC-DS SF1 Q11 and held-out query-family cases",
    "resource_envelope": {
      "planning_dop": 1,
      "execution_dop": 4,
      "memory_limit": "2GB",
      "concurrent_target_statements": 1
    },
    "occurrence_nodes": [
      "scan",
      "date_join",
      "partial_aggregate",
      "final_aggregate",
      "residual_filter",
      "cte_producer",
      "cte_consumer",
      "root_join"
    ],
    "required_identity": [
      "occurrence_id",
      "logical_node_id",
      "physical_occurrence_id",
      "column_id",
      "condition_domain_id",
      "evidence_source",
      "calibration_revision"
    ],
    "held_out_required": true,
    "out_of_scope": [
      "EXPLAIN-only estimates without same-operation execution evidence",
      "runtime operator IDs or display paths used as logical occurrence identity",
      "unknown, stale, or partial evidence promoted to complete-domain proof",
      "a Q11-only SQL or table-name route"
    ]
  },
  "gates": {
    "G-Stats": {
      "thresholds": {
        "q_error_p95_max": 2.0,
        "q_error_max": 4.0,
        "conditional_domain_coverage_min": 1.0,
        "held_out_coverage_min": 1.0
      },
      "required_checks": [
        "finite_bag_duplicate_and_null_semantics",
        "condition_domain_idempotence",
        "outer_null_extension",
        "base_filtered_occurrence_join_intersection_separation",
        "complete_partial_derived_unknown_provenance_separation"
      ],
      "admission": "only declared occurrence identities with complete evidence and held-out coverage may enter the production quality path"
    },
    "G-Cost": {
      "thresholds": {
        "phase_time_prediction_p95_ratio_max": 1.25,
        "candidate_selection_loss_p95_ratio_max": 1.10,
        "cold_first_statement_prediction_p95_ratio_max": 1.25,
        "held_out_coverage_min": 1.0
      },
      "required_checks": [
        "scan_decode_and_downstream_work_separate",
        "reference_domain_pushdown_narrow_partial_final_comparison",
        "inline_shared_partitioned_candidate_comparison",
        "fresh_process_phase_trace",
        "finite_domain_candidate_selection_loss"
      ],
      "admission": "only matching calibration revision, declared resource envelope, fresh-process phase evidence, and held-out coverage may enable economic policy"
    }
  },
  "missing_evidence": "Uncovered",
  "observations": []
}
