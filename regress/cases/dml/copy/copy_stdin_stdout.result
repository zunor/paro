id,name,note
10,stdin-a,
11,"stdin,comma","quote ""again"""
12,stdin-c,plain
13,stdin-d,"slash\\path"

SELECT id, name, note
FROM dml_copy_protocol_dst
ORDER BY id;
id	name	note
10	stdin-a	NULL
11	stdin,comma	quote "again"
