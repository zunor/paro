DROP TABLE IF EXISTS vector_topn_case;
DROP TABLE

CREATE TABLE vector_topn_case (
    id INT PRIMARY KEY,
    category VARCHAR,
    emb VECTOR(3)
);
CREATE TABLE

INSERT INTO vector_topn_case VALUES
    (1, 'x', '[1,0,0]'),
    (2, 'x', '[0,1,0]'),
    (3, 'y', '[0,0,1]'),
    (4, 'y', '[2,0,0]'),
    (5, 'z', '[-1,0,0]');
