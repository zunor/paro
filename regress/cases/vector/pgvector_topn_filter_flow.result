DROP TABLE IF EXISTS vector_topn_case;
DROP TABLE

CREATE TABLE vector_topn_case (
    id INT PRIMARY KEY,
    category VARCHAR,
    emb VECTOR(3)
);
CREATE TABLE

INSERT INTO vector_topn_case VALUES
    (1, 'x', '[1,0,0]'),
    (2, 'x', '[0,1,0]'),
    (3, 'y', '[0,0,1]'),
    (4, 'y', '[2,0,0]'),
    (5, 'z', '[-1,0,0]');
INSERT 0 5

EXPLAIN SELECT id FROM vector_topn_case ORDER BY emb <-> '[1,0,0]' LIMIT 3;
QUERY PLAN
PROJECTION  (rows=3)
  Output: id
  ->  TOP_N  (rows=3)
        Sort Key: L2_DISTANCE(emb, CAST('[1,0,0]' AS FLOAT[3])) ASC NULLS LAST
        Limit: 3
        ->  PROJECTION  (rows=5)
              Output: id, L2_DISTANCE(emb, CAST('[1,0,0]' AS FLOAT[3]))
              ->  ROWSET_SCAN on public.vector_topn_case
                    Columns: id, emb

SELECT id FROM vector_topn_case ORDER BY emb <-> '[1,0,0]', id LIMIT 3;
id
1
4
2

EXPLAIN SELECT id FROM vector_topn_case WHERE category = 'x' ORDER BY emb <+> '[1,0,0]' LIMIT 2;
QUERY PLAN
PROJECTION  (rows=1)
  Output: id
  ->  TOP_N  (rows=1)
        Sort Key: L1_DISTANCE(emb, CAST('[1,0,0]' AS FLOAT[3])) ASC NULLS LAST
        Limit: 2
        ->  PROJECTION  (rows=1)
              Output: id, L1_DISTANCE(emb, CAST('[1,0,0]' AS FLOAT[3]))
              ->  ROWSET_SCAN on public.vector_topn_case
                    Columns: id, category, emb
                    Filter: category = 'x'

SELECT id FROM vector_topn_case WHERE category = 'x' ORDER BY emb <+> '[1,0,0]', id LIMIT 2;
id
1
2

EXPLAIN SELECT id FROM vector_topn_case ORDER BY emb <=> '[1,0,0]' LIMIT 3;
QUERY PLAN
PROJECTION  (rows=3)
  Output: id
  ->  TOP_N  (rows=3)
        Sort Key: COSINE_DISTANCE(emb, CAST('[1,0,0]' AS FLOAT[3])) ASC NULLS LAST
        Limit: 3
        ->  PROJECTION  (rows=5)
              Output: id, COSINE_DISTANCE(emb, CAST('[1,0,0]' AS FLOAT[3]))
              ->  ROWSET_SCAN on public.vector_topn_case
                    Columns: id, emb

SELECT id FROM vector_topn_case ORDER BY emb <=> '[1,0,0]', id LIMIT 3;
id
1
4
2

EXPLAIN SELECT id FROM vector_topn_case ORDER BY emb <#> '[1,0,0]' LIMIT 3;
QUERY PLAN
PROJECTION  (rows=3)
  Output: id
  ->  TOP_N  (rows=3)
        Sort Key: NEG_INNER_PRODUCT(emb, CAST('[1,0,0]' AS FLOAT[3])) ASC NULLS LAST
        Limit: 3
        ->  PROJECTION  (rows=5)
              Output: id, NEG_INNER_PRODUCT(emb, CAST('[1,0,0]' AS FLOAT[3]))
              ->  ROWSET_SCAN on public.vector_topn_case
                    Columns: id, emb

SELECT id FROM vector_topn_case ORDER BY emb <#> '[1,0,0]', id LIMIT 3;
id
4
1
2

DROP TABLE vector_topn_case;
