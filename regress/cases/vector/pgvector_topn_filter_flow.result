EXPLAIN SELECT id FROM vector_topn_case ORDER BY emb <-> '[1,0,0]' LIMIT 3;
QUERY PLAN
PROJECTION  (rows=3)
  Output: id
  ->  ADAPTIVE_SCAN on public.vector_topn_case
        Search Decision: DEFER_TO_RUNTIME sequential_cost=5.000 candidates=1

