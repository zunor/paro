DROP TABLE IF EXISTS vector_topn_case;
DROP TABLE

CREATE TABLE vector_topn_case (
    id INT PRIMARY KEY,
    category VARCHAR,
    emb VECTOR(3)
);
CREATE TABLE

INSERT INTO vector_topn_case VALUES
    (1, 'x', '[1,0,0]'),
    (2, 'x', '[0,1,0]'),
    (3, 'y', '[0,0,1]'),
    (4, 'y', '[2,0,0]'),
    (5, 'z', '[-1,0,0]');
INSERT 0 5

EXPLAIN SELECT id FROM vector_topn_case ORDER BY emb <-> '[1,0,0]' LIMIT 3;
QUERY PLAN
PROJECTION  (rows=3)
  Output: id
  ->  TOP_N  (rows=3)
    Sort Key: l2_distance(emb, [1, 0, 0]) ASC NULLS LAST
    Limit: 3
    ->  PROJECTION  (rows=5)
      Output: id, l2_distance(emb, [1, 0, 0])
      ->  ROWSET_SCAN on public.vector_topn_case  (rows=5)
        Columns: id, emb

SELECT id FROM vector_topn_case ORDER BY emb <-> '[1,0,0]', id LIMIT 3;
id
1
4
2

EXPLAIN SELECT id FROM vector_topn_case WHERE category = 'x' ORDER BY emb <+> '[1,0,0]' LIMIT 2;
QUERY PLAN
PROJECTION  (rows=2)
  Output: id
  ->  TOP_N  (rows=2)
    Sort Key: l1_distance(emb, [1, 0, 0]) ASC NULLS LAST
    Limit: 2
    ->  PROJECTION  (rows=2)
      Output: id, l1_distance(emb, [1, 0, 0])
      ->  ROWSET_SCAN on public.vector_topn_case  (rows=2)
        Columns: id, emb
        Pushed Predicate: category = 'x'
        Late Materialize: auto

SELECT id FROM vector_topn_case WHERE category = 'x' ORDER BY emb <+> '[1,0,0]', id LIMIT 2;
id
1
2

EXPLAIN SELECT id FROM vector_topn_case ORDER BY emb <=> '[1,0,0]' LIMIT 3;
QUERY PLAN
PROJECTION  (rows=3)
  Output: id
  ->  TOP_N  (rows=3)
    Sort Key: cosine_distance(emb, [1, 0, 0]) ASC NULLS LAST
    Limit: 3
    ->  PROJECTION  (rows=5)
      Output: id, cosine_distance(emb, [1, 0, 0])
      ->  ROWSET_SCAN on public.vector_topn_case  (rows=5)
        Columns: id, emb

SELECT id FROM vector_topn_case ORDER BY emb <=> '[1,0,0]', id LIMIT 3;
id
1
4
2

EXPLAIN SELECT id FROM vector_topn_case ORDER BY emb <#> '[1,0,0]' LIMIT 3;
QUERY PLAN
PROJECTION  (rows=3)
  Output: id
  ->  TOP_N  (rows=3)
    Sort Key: neg_inner_product(emb, [1, 0, 0]) ASC NULLS LAST
    Limit: 3
    ->  PROJECTION  (rows=5)
      Output: id, neg_inner_product(emb, [1, 0, 0])
      ->  ROWSET_SCAN on public.vector_topn_case  (rows=5)
        Columns: id, emb

SELECT id FROM vector_topn_case ORDER BY emb <#> '[1,0,0]', id LIMIT 3;
