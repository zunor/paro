CREATE TABLE type_roundtrip_list (
  id INT,
  ints LIST(INTEGER),
  words LIST(VARCHAR),
  nums LIST(DOUBLE),
  flags LIST(BOOLEAN)
);
CREATE TABLE

INSERT INTO type_roundtrip_list VALUES
