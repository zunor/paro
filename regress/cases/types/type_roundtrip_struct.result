CREATE TABLE type_roundtrip_struct (
  id INT,
  person STRUCT(name VARCHAR, age INTEGER, score DOUBLE, active BOOLEAN)
);
CREATE TABLE

INSERT INTO type_roundtrip_struct VALUES
  (1, ('alice', 30, 98.5, true)),
  (2, ('', NULL, -1.0, false)),
  (3, NULL),
  (4, ('bob', 0, 0.0, NULL));
INSERT 0 4

-- @query rowsort
SELECT id, person
FROM type_roundtrip_struct
ORDER BY id;
id	person
1	STRUCT(name: 'alice', age: 30, score: 98.5, active: true)
2	STRUCT(name: '', age: NULL, score: -1, active: false)
3	NULL
4	STRUCT(name: 'bob', age: 0, score: 0, active: NULL)

-- @query rowsort
SELECT id, person IS NULL AS person_is_null
FROM type_roundtrip_struct
ORDER BY id;
id	person_is_null
1	false
2	false
3	true
4	false
