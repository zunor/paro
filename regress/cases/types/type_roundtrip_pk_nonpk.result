DROP TABLE IF EXISTS type_roundtrip_nonpk;
DROP TABLE

CREATE TABLE type_roundtrip_pk (
  id INT PRIMARY KEY,
  b BOOLEAN,
  i INT,
  u UINT,
  f FLOAT,
  d DOUBLE,
  v VARCHAR,
  dt DATE,
  ts TIMESTAMP
);
CREATE TABLE

CREATE TABLE type_roundtrip_nonpk (
  id INT,
  b BOOLEAN,
  i INT,
  u UINT,
  f FLOAT,
  d DOUBLE,
  v VARCHAR,
  dt DATE,
  ts TIMESTAMP
);
CREATE TABLE

