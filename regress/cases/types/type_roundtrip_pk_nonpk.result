-- @query approx(0.0001)
SELECT 'pk' AS path, id, b, i, u, f, d, v, dt, ts
FROM type_roundtrip_pk
UNION ALL
SELECT 'nonpk' AS path, id, b, i, u, f, d, v, dt, ts
FROM type_roundtrip_nonpk
ORDER BY path, id;
