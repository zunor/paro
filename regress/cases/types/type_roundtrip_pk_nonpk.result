pk	3	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL
nonpk	1	true	42	4000000000	1.500000	2.250000	alpha	2024-01-01 00:00:00	2024-01-01 12:00:00
nonpk	2	false	-7	0	0.000000	-3.500000	(empty)	1970-01-01 00:00:00	1970-01-01 00:00:00
