    MATCH (b:Person)<-[k:Knows]-(a:Person WHERE a.name = 'Charlie')
    COLUMNS (a.name AS src, b.name AS dst)
) gt
ORDER BY dst;
gt.src	gt.dst
Charlie	Diana

