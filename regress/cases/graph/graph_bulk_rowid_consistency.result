    MATCH (a:Person WHERE a.name = 'Grace')-[k:Knows]->(b:Person)
    COLUMNS (a.name AS src, a.city AS src_city, a.score AS src_score,
             b.name AS dst, b.city AS dst_city, b.score AS dst_score)
) gt
