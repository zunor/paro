CREATE TABLE brc_person (
    id BIGINT PRIMARY KEY,
    name VARCHAR,
    age INT,
    score INT,
    city VARCHAR
);
CREATE TABLE

CREATE TABLE brc_org (
    id BIGINT PRIMARY KEY,
    name VARCHAR,
    founded INT,
    headcount INT
);
CREATE TABLE

CREATE TABLE brc_knows (
    src_id BIGINT,
    dst_id BIGINT,
    weight INT,
    tag VARCHAR
);
CREATE TABLE

CREATE TABLE brc_member (
    person_id BIGINT,
    org_id BIGINT,
    role VARCHAR,
    tenure INT
);
CREATE TABLE

