SELECT src, count(*) AS cnt, sum(dst_age) AS total_age, sum(w) AS total_weight
FROM GRAPH_TABLE(brc_graph
    MATCH (a:Person)-[k:Knows]->(b:Person)
    COLUMNS (a.name AS src, b.age AS dst_age, k.weight AS w)
) gt
GROUP BY src
ORDER BY src;
