SELECT org, count(*) AS member_count, sum(tenure) AS total_tenure
FROM GRAPH_TABLE(brc_graph
    MATCH (p:Person)-[m:MemberOf]->(o:Org)
    COLUMNS (o.name AS org, m.tenure AS tenure)
) gt
GROUP BY org
ORDER BY org;
