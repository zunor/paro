SELECT * FROM GRAPH_TABLE(brc_graph
    MATCH (a:Person WHERE a.age >= 30)-[k:Knows]->(b:Person WHERE b.age < 30)
    COLUMNS (a.name AS src, a.age AS src_age, b.name AS dst, b.age AS dst_age,
             k.weight AS w)
) gt
ORDER BY src, dst;
