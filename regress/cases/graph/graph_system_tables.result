SELECT * FROM paro_property_graphs();
paro_property_graphs.graph_name	paro_property_graphs.vertex_tables	paro_property_graphs.edge_tables	paro_property_graphs.vertex_count	paro_property_graphs.edge_count	paro_property_graphs.state	paro_property_graphs.delta_size	paro_property_graphs.last_rebuild	paro_property_graphs.fingerprint	paro_property_graphs.index_size_bytes

CREATE PROPERTY GRAPH social_network
VERTEX TABLES (
    person LABEL Person,
    company LABEL Company
)
EDGE TABLES (
    knows
        SOURCE KEY (person1_id) REFERENCES person (id)
        DESTINATION KEY (person2_id) REFERENCES person (id)
        LABEL Knows,
    works_at
        SOURCE KEY (person_id) REFERENCES person (id)
        DESTINATION KEY (company_id) REFERENCES company (id)
        LABEL WorksAt
);
CREATE PROPERTY GRAPH

SELECT
    graph_name,
    vertex_tables,
    edge_tables,
    vertex_count,
    edge_count,
    state,
    delta_size,
    (last_rebuild IS NOT NULL) AS has_last_rebuild,
    (fingerprint <> '') AS has_fingerprint
FROM paro_property_graphs();
graph_name	vertex_tables	edge_tables	vertex_count	edge_count	state	delta_size	has_last_rebuild	has_fingerprint
social_network	Person, Company	Knows, WorksAt	5	6	READY	0	true	true

SELECT label, type, count FROM paro_graph_statistics('social_network') ORDER BY type, label;
label	type	count
Knows	edge	3
WorksAt	edge	3
Company	vertex	2
Person	vertex	3

SELECT label, type, count, avg_degree FROM paro_graph_statistics('social_network') WHERE type = 'edge' ORDER BY label;
label	type	count	avg_degree
Knows	edge	3	1.000000
WorksAt	edge	3	1.000000

SELECT * FROM paro_graph_statistics('nonexistent');
paro_graph_statistics.label	paro_graph_statistics.type	paro_graph_statistics.count	paro_graph_statistics.avg_degree	paro_graph_statistics.index_size_bytes

SELECT label, type, (index_size_bytes > 0) AS has_index FROM paro_graph_statistics('social_network') ORDER BY type, label;
label	type	has_index
Knows	edge	true
WorksAt	edge	true
Company	vertex	true
Person	vertex	true

