CREATE TABLE br_person (
    id BIGINT PRIMARY KEY,
    name VARCHAR,
    age INT,
    score INT,
    city VARCHAR
);
CREATE TABLE

CREATE TABLE br_company (
    id BIGINT PRIMARY KEY,
    name VARCHAR,
    founded INT,
    size INT
);
CREATE TABLE

CREATE TABLE br_knows (
    person1_id BIGINT,
    person2_id BIGINT,
    since DATE,
    weight INT
);
CREATE TABLE

CREATE TABLE br_works_at (
    person_id BIGINT,
    company_id BIGINT,
    role VARCHAR,
    salary INT
);
CREATE TABLE

