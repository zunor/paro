    MATCH (a:Person)-[e:Knows]->(b:Person)
    COLUMNS (a.name AS src, b.name AS dst)
) gt
ORDER BY src, dst;
src	dst
Alice	Bob
Bob	Carol

DELETE FROM refresh_knows WHERE src_id = 1 AND dst_id = 2;
DELETE 1

