CREATE PROPERTY GRAPH start_graph
VERTEX TABLES (
    ssp_person LABEL Person,
    ssp_company LABEL Company,
    ssp_city LABEL City
)
EDGE TABLES (
    ssp_works_at
        SOURCE KEY (person_id) REFERENCES ssp_person (id)
        DESTINATION KEY (company_id) REFERENCES ssp_company (id)
        LABEL WorksAt,
    ssp_located_in
        SOURCE KEY (company_id) REFERENCES ssp_company (id)
        DESTINATION KEY (city_id) REFERENCES ssp_city (id)
        LABEL LocatedIn
);
CREATE PROPERTY GRAPH

EXPLAIN SELECT * FROM GRAPH_TABLE(start_graph
    MATCH (p:Person)-[w:WorksAt]->(c:Company WHERE c.name = 'Acme')-[l:LocatedIn]->(city:City)
    COLUMNS (p.name AS person_name, c.name AS company_name, city.name AS city_name)
) gt;
QUERY PLAN
PROJECTION  (rows=1)
  Output: gt.person_name, gt.company_name, gt.city_name
  ->  GRAPH_PROJECT  (rows=1)
    Output: person_name, company_name, city_name
    ->  GRAPH_EXPAND  (rows=1)
      Graph: start_graph
      Edge Label: WorksAt
      Direction: Backward
      ->  GRAPH_EXPAND  (rows=1)
        Graph: start_graph
        Edge Label: LocatedIn
        Direction: Forward
        ->  GRAPH_SCAN  (rows=1)
          Graph: start_graph
          Vertex Label: Company
          Table: ssp_company
          Filter: <pushed down>

SELECT * FROM GRAPH_TABLE(start_graph
    MATCH (p:Person)-[w:WorksAt]->(c:Company WHERE c.name = 'Acme')-[l:LocatedIn]->(city:City)
    COLUMNS (p.name AS person_name, c.name AS company_name, city.name AS city_name)
) gt
ORDER BY person_name;
gt.person_name	gt.company_name	gt.city_name
Alice	Acme	NYC
Charlie	Acme	NYC

DROP PROPERTY GRAPH start_graph;
DROP PROPERTY GRAPH

