        ->  GRAPH_SHORTEST_PATH  (rows=12000)
              Graph: social_network
              Edge Label: Knows
              Direction: Forward
              Path Mode: ALL SHORTEST
              Hops: {1,3}
              ->  GRAPH_SCAN  (rows=1000)
                    Graph: social_network
                    Vertex Label: Person
                    Table: person

