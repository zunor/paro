    MATCH p = ANY SHORTEST (a:Node WHERE a.name = 'A')-[e:Follows]->{1,4}(b:Node WHERE b.name = 'E')
    COLUMNS (a.name AS src, b.name AS dst, path_length(p) AS hops)
) gt;
gt.src	gt.dst	gt.hops
