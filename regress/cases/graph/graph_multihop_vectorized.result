gt.src	gt.dst

SELECT * FROM GRAPH_TABLE(mv_graph
    MATCH (a:Node WHERE a.name = 'A')-[e:Follows]->{3,4}(b:Node)
    COLUMNS (a.name AS src, b.name AS dst)
