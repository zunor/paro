CREATE TABLE mv_person (id BIGINT PRIMARY KEY, name VARCHAR, city VARCHAR);
CREATE TABLE

CREATE TABLE mv_follows (src_id BIGINT, dst_id BIGINT, weight INT);
CREATE TABLE

INSERT INTO mv_person VALUES
