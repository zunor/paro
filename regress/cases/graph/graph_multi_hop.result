CREATE TABLE mh_person (id BIGINT PRIMARY KEY, name VARCHAR);
CREATE TABLE

CREATE TABLE mh_follows (src_id BIGINT, dst_id BIGINT, weight INT);
CREATE TABLE

INSERT INTO mh_person VALUES (1, 'A'), (2, 'B'), (3, 'C'), (4, 'D'), (5, 'E');
