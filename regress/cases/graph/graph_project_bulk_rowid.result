CREATE TABLE gp_person (
    id BIGINT PRIMARY KEY,
    name VARCHAR,
    age INT,
    city VARCHAR
);
CREATE TABLE

CREATE TABLE gp_org (
    id BIGINT PRIMARY KEY,
    name VARCHAR,
    founded INT
);
CREATE TABLE

CREATE TABLE gp_friend (
    src_id BIGINT,
    dst_id BIGINT,
    since INT,
    strength INT
);
CREATE TABLE

CREATE TABLE gp_member (
    person_id BIGINT,
    org_id BIGINT,
    role VARCHAR,
    years INT
);
CREATE TABLE

