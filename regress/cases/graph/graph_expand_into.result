    (2, 1),
    (3, 1);
INSERT 0 2

INSERT INTO ei_route VALUES
    (2, 4),
    (4, 1),
    (3, 5),
    (5, 4);
INSERT 0 4

CREATE PROPERTY GRAPH ei_graph
VERTEX TABLES (
    ei_person LABEL Node
)
EDGE TABLES (
    ei_knows
        SOURCE KEY (src_id) REFERENCES ei_person (id)
        DESTINATION KEY (dst_id) REFERENCES ei_person (id)
        LABEL Knows,
    ei_seed
        SOURCE KEY (src_id) REFERENCES ei_person (id)
        DESTINATION KEY (dst_id) REFERENCES ei_person (id)
        LABEL Seed,
    ei_route
        SOURCE KEY (src_id) REFERENCES ei_person (id)
        DESTINATION KEY (dst_id) REFERENCES ei_person (id)
        LABEL Route
);
CREATE PROPERTY GRAPH

SELECT * FROM GRAPH_TABLE(ei_graph
    MATCH (a:Node WHERE a.name = 'Alice')-[k:Knows]->(b:Node WHERE b.name = 'Bob')
    COLUMNS (a.name AS anchor, b.name AS neighbor)
) gt
ORDER BY neighbor;
gt.anchor	gt.neighbor
Alice	Bob

EXPLAIN SELECT * FROM GRAPH_TABLE(ei_graph
    MATCH (a:Node WHERE a.name = 'Alice')-[k:Knows]->(b:Node WHERE b.name = 'Bob')
    COLUMNS (a.name AS anchor, b.name AS neighbor)
) gt;
QUERY PLAN
PROJECTION  (rows=1)
  Output: gt.anchor, gt.neighbor
  ->  GRAPH_PROJECT  (rows=1)
    Output: gt.anchor, gt.neighbor
    Filter: <pushed down>
    ->  GRAPH_EXPAND  (rows=1)
      Graph: ei_graph
      Edge Label: Knows
      Direction: Forward
      ->  GRAPH_SCAN  (rows=1)
        Graph: ei_graph
        Vertex Label: Node
        Table: ei_person
        Filter: <pushed down>

SELECT * FROM GRAPH_TABLE(ei_graph
    MATCH ANY SHORTEST (a:Node WHERE a.name = 'Carol')-[r:Route]->{1,3}(b:Node WHERE b.name = 'Alice')
    COLUMNS (a.name AS src, b.name AS dst)
) gt
ORDER BY src, dst;
gt.src	gt.dst
Carol	Alice

EXPLAIN SELECT * FROM GRAPH_TABLE(ei_graph
    MATCH ANY SHORTEST (a:Node WHERE a.name = 'Carol')-[r:Route]->{1,3}(b:Node WHERE b.name = 'Alice')
    COLUMNS (a.name AS src, b.name AS dst)
) gt;
QUERY PLAN
PROJECTION  (rows=3)
  Output: gt.src, gt.dst
  ->  GRAPH_PROJECT  (rows=3)
    Output: gt.src, gt.dst
    Filter: <pushed down>
    ->  GRAPH_SHORTEST_PATH  (rows=3)
      Graph: ei_graph
      Edge Label: Route
      Direction: Forward
      Hops: {1,3}
      ->  GRAPH_SCAN  (rows=1)
        Graph: ei_graph
        Vertex Label: Node
        Table: ei_person
        Filter: <pushed down>

DROP PROPERTY GRAPH ei_graph;
DROP PROPERTY GRAPH

DROP TABLE ei_route;
DROP TABLE

DROP TABLE ei_seed;
DROP TABLE

DROP TABLE ei_knows;
DROP TABLE

DROP TABLE ei_person;
DROP TABLE
