SELECT l.id AS l_id, r.id AS r_id, r.payload
FROM join_spill_l l
FULL JOIN join_spill_r r
  ON l.k1 = r.k1 AND l.k2 = r.k2
ORDER BY COALESCE(l.id, 1000000), COALESCE(r.id, 1000000);
l_id	r_id	r.payload
