SELECT l.id AS l_id, r.id AS r_id
FROM join_spill_l l
JOIN join_spill_r r
  ON l.k1 = r.k1 AND l.k2 = r.k2 AND l.v < r.v
ORDER BY l.id;
l_id	r_id
1	10
2	11
3	12

