2	r11
3	r12
4	r14

SELECT l.id AS l_id, r.id AS r_id, r.payload
FROM join_spill_l l
LEFT JOIN join_spill_r r
  ON l.k1 = r.k1 AND l.k2 = r.k2
ORDER BY l.id;
l_id	r_id	r.payload
