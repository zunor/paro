SELECT l.id, l.payload
FROM join_elim_left AS l
LEFT JOIN join_elim_right_unique AS r ON l.id = r.id
ORDER BY l.id;
l.id	l.payload
1	left-1
2	left-2
3	left-3

EXPLAIN
SELECT l.id, l.payload
FROM join_elim_left AS l
LEFT JOIN join_elim_right_unique AS r ON l.id = r.id;
QUERY PLAN
PROJECTION  (rows=3)
  Output: l.id, l.payload
  ->  ROWSET_SCAN on public.join_elim_left l  (rows=3)
    Columns: l.id, l.payload

EXPLAIN
SELECT l.id, r.note
FROM join_elim_left AS l
LEFT JOIN join_elim_right_unique AS r ON l.id = r.id;
QUERY PLAN
PROJECTION  (rows=3)
  Output: l.id, r.note
  ->  HASH_JOIN  (rows=3)
    Join Type: LEFT
    Build Index: integer_build_time
    Join Condition: l.id = r.id
    ->  ROWSET_SCAN on public.join_elim_left l  (rows=3)
      Columns: id
    ->  ROWSET_SCAN on public.join_elim_right_unique r  (rows=2)
      Columns: id, note

SELECT r.id, r.note
FROM join_elim_left_unique AS l
RIGHT JOIN join_elim_right AS r ON l.id = r.id
ORDER BY r.id, r.note;
r.id	r.note
2	right-only-2
4	right-only-4

EXPLAIN
SELECT r.id, r.note
FROM join_elim_left_unique AS l
RIGHT JOIN join_elim_right AS r ON l.id = r.id;
QUERY PLAN
PROJECTION  (rows=2)
  Output: r.id, r.note
  ->  ROWSET_SCAN on public.join_elim_right r  (rows=2)
    Columns: r.id, r.note

