-- @query rowsort
SELECT *
FROM join_semi_left AS l
RIGHT SEMI JOIN join_semi_right AS r ON l.id = r.id;
r.id	r.grp	r.budget	r.flag
1	10	1000	r1
2	10	900	r2
3	20	1500	r3
3	20	1600	r3_dup

-- @query rowsort
SELECT *
FROM join_semi_left AS l
RIGHT ANTI JOIN join_semi_right AS r ON l.id = r.id;
r.id	r.grp	r.budget	r.flag
6	30	500	r6

