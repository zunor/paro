-- @query rowsort
SELECT *
FROM join_semi_left AS l
SEMI JOIN join_semi_right AS r ON l.id = r.id;
l.id	l.grp	l.amount	l.tag
1	10	50	l1
2	10	75	l2
3	20	60	l3
3	20	65	l3_dup

-- @query rowsort
SELECT *
FROM join_semi_left AS l
ANTI JOIN join_semi_right AS r ON l.id = r.id;
l.id	l.grp	l.amount	l.tag
4	20	90	l4
5	30	100	l5

-- @query rowsort
SELECT *
FROM join_semi_left AS l
SEMI JOIN (
  SELECT id
  FROM join_semi_right
  WHERE budget >= 1500
) AS r ON l.id = r.id;
l.id	l.grp	l.amount	l.tag
3	20	60	l3
3	20	65	l3_dup

-- @query rowsort
SELECT *
FROM join_semi_left AS l
ANTI JOIN join_semi_right AS r
  ON l.id = r.id AND l.amount + r.budget > 1100;
l.id	l.grp	l.amount	l.tag
1	10	50	l1
2	10	75	l2
4	20	90	l4
5	30	100	l5

