SELECT x, row_number() OVER (ORDER BY x) AS rn
FROM (VALUES (3), (1), (2)) AS values_input(x)
ORDER BY x;
x	rn
1	1
2	2
3	3

SELECT
    category,
    sum(x) AS total,
    row_number() OVER (ORDER BY sum(x) DESC) AS rn
FROM (
    VALUES ('A', 1),
           ('A', 2),
           ('B', 7),
           ('C', 4)
) AS aggregate_input(category, x)
GROUP BY category
ORDER BY category;
category	total	rn
A	3	3
B	7	1
C	4	2

EXPLAIN SELECT x, row_number() OVER (ORDER BY x) AS rn
FROM (VALUES (3), (1), (2)) AS qualify_input(x)
QUALIFY row_number() OVER (ORDER BY x) <= 2
ORDER BY x;
QUERY PLAN
PROJECTION  (rows=1)
  Output: x, rn
  ->  ORDER_BY  (rows=1)
    Sort Key: #2 ASC NULLS LAST
    ->  PROJECTION  (rows=1)
      Output: x, rn, __paro_hidden_1
      ->  FILTER  (rows=1)
        Filter: #1 <= 2
        ->  WINDOW  (rows=3)
          ->  PROJECTION  (rows=3)
            Output: x
            ->  VALUES  (rows=3)

SELECT x, row_number() OVER (ORDER BY x) AS rn
FROM (VALUES (3), (1), (2)) AS qualify_input(x)
QUALIFY row_number() OVER (ORDER BY x) <= 2
ORDER BY x;
x	rn
1	1
2	2

EXPLAIN SELECT x
FROM (
    SELECT x, row_number() OVER (ORDER BY x) AS unused_rn
    FROM (VALUES (3), (1), (2)) AS unused_window_input(x)
) AS unused_window
ORDER BY x;
QUERY PLAN
PROJECTION  (rows=3)
  Output: x
  ->  ORDER_BY  (rows=3)
    Sort Key: #1 ASC NULLS LAST
    ->  PROJECTION  (rows=3)
      Output: x, __paro_hidden_1
      ->  PROJECTION  (rows=3)
        Output: x
        ->  PROJECTION  (rows=3)
          Output: x
          ->  PROJECTION  (rows=3)
            Output: x
            ->  VALUES  (rows=3)

SELECT
    category,
    x,
    row_number() OVER (PARTITION BY category ORDER BY x) AS category_rn,
    row_number() OVER (ORDER BY x DESC) AS global_desc_rn,
    rank() OVER (PARTITION BY category ORDER BY x) AS category_rank
FROM (VALUES ('A', 1), ('A', 3), ('B', 2), ('B', 4)) AS mixed_layout_input(category, x)
ORDER BY x;
category	x	category_rn	global_desc_rn	category_rank
A	1	1	4	1
B	2	1	3	1
A	3	2	2	2
B	4	2	1	2

SELECT
    category,
    x,
    row_number() OVER (PARTITION BY category ORDER BY x) AS category_rn
FROM (VALUES ('A', 1), ('A', 3), ('B', 2), ('B', 4)) AS mixed_qualify_input(category, x)
QUALIFY row_number() OVER (ORDER BY x DESC) <= 2
ORDER BY x;
category	x	category_rn
A	3	2
B	4	2
