SELECT
    id,
    SUM(score) FILTER (WHERE score >= 80) OVER () AS high_score_sum,
    COUNT(score) OVER () AS non_null_scores,
    AVG(score) OVER () AS average_score
FROM (
    VALUES (1, 10), (2, NULL), (3, 30), (4, 90)
) AS global_window_input(id, score)
ORDER BY id;
