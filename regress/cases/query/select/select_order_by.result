    (2, 10, 'banana', 'payload_medium_bbbbb'),
    (3, 20, 'banana', 'payload_long_cccccccccccccc'),
    (4, 20, 'zebra', 'payload_x'),
    (5, 10, 'apple', 'payload_very_long_dddddddddddddddddd'),
    (6, 30, 'banana', NULL);
