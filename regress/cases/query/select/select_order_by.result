CREATE TABLE order_null_test (id INT, grp INT, label VARCHAR);
CREATE TABLE

INSERT INTO order_null_test VALUES
    (1, 1, 'alpha'),
    (2, 1, NULL),
    (3, 2, 'beta'),
    (4, NULL, 'delta'),
    (5, 1, 'gamma'),
    (6, NULL, NULL),
    (7, 2, 'beta'),
    (8, 1, 'alpha');
