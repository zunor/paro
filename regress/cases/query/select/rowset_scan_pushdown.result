EXPLAIN (VERBOSE)
SELECT COUNT(*)
FROM rowset_pushdown_case c
JOIN rowset_pushdown_dim d ON c.k = d.k;
QUERY PLAN
PROJECTION  (rows=1)
  Output: COUNT(*)
  Cardinality: [1, 1, 1]
  Output Schema: COUNT(*) BIGINT
  ->  AGGREGATE  (rows=1)
    Aggregates: count_star(*)
    Output: aggr_0
    Cardinality: [1, 1, 1]
    Output Schema: aggr_0 BIGINT
    ->  HASH_JOIN  (rows=64)
      Join Type: INNER
      Join Condition: #0 = #0
      Cardinality: [64, 64, 64]
      Output Schema: k INTEGER, k INTEGER
      ->  ROWSET_SCAN on public.rowset_pushdown_case c
        Columns: k
        Pushed Predicate: col#1 >= 2 AND col#1 <= 8
        Runtime Filter: #0 >= 2 AND #0 <= 8
        Output Schema: k INTEGER
      ->  ROWSET_SCAN on public.rowset_pushdown_dim d  (rows=3)
        Columns: k
        Cardinality: [3, 3, 3]
        Output Schema: k INTEGER

EXPLAIN (VERBOSE)
SELECT id FROM rowset_pushdown_case ORDER BY score ASC LIMIT 5;
QUERY PLAN
PROJECTION  (rows=5)
  Output: id
  Cardinality: [5, 5, 5]
  Output Schema: id INTEGER
  ->  TOP_N  (rows=5)
    Sort Key: #1 ASC NULLS LAST
    Limit: 5
    Cardinality: [5, 5, 5]
    Output Schema: id INTEGER, __paro_hidden_1 INTEGER
    ->  PROJECTION  (rows=64)
      Output: id, __paro_hidden_1
      Cardinality: [64, 64, 64]
      Output Schema: id INTEGER, __paro_hidden_1 INTEGER
      ->  ROWSET_SCAN on public.rowset_pushdown_case  (rows=64)
        Columns: id, score
        Scan Order: col#3 ASC by min LIMIT 5
        Cardinality: [64, 64, 64]
        Output Schema: id INTEGER, score INTEGER

