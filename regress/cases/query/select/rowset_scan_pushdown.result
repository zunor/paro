EXPLAIN (VERBOSE)
SELECT COUNT(*)
FROM rowset_pushdown_case c
JOIN rowset_pushdown_dim d ON c.k = d.k;
QUERY PLAN
PROJECTION  (rows=1)
  Output: COUNT(*)
  Cardinality: [1, 1, 1]
  Output Schema: "COUNT(*)" BIGINT
  ->  AGGREGATE  (rows=1)
    Aggregates: count_star(*)
    Cardinality: [1, 1, 1]
    Output Schema: aggregate_state_1 BIGINT
    ->  HASH_JOIN  (rows=19)
      Join Type: INNER
      Build Index: integer_build_time
      Join Condition: c.k = d.k
      Cardinality: [19, 19, 19]
      Output Schema: (none)
      ->  ROWSET_SCAN on public.rowset_pushdown_case c
        Columns: k
        Pushed Predicate: k >= 2 AND k <= 8
        Runtime Filter: k >= 2 AND k <= 8
        Output Schema: c.k INTEGER
      ->  ROWSET_SCAN on public.rowset_pushdown_dim d  (rows=3)
        Columns: k
        Cardinality: [3, 3, 3]
        Output Schema: d.k INTEGER

EXPLAIN (VERBOSE)
SELECT id FROM rowset_pushdown_case ORDER BY score ASC LIMIT 5;
QUERY PLAN
PROJECTION  (rows=5)
  Output: id
  Cardinality: [5, 5, 5]
  Output Schema: id INTEGER
  ->  TOP_N  (rows=5)
    Sort Key: public.rowset_pushdown_case.score ASC NULLS LAST
    Limit: 5
    Cardinality: [5, 5, 5]
    Output Schema: id INTEGER, public.rowset_pushdown_case.score INTEGER
    ->  PROJECTION  (rows=64)
      Output: id, score
      Cardinality: [64, 64, 64]
      Output Schema: id INTEGER, public.rowset_pushdown_case.score INTEGER
      ->  ROWSET_SCAN on public.rowset_pushdown_case  (rows=64)
        Columns: id, score
        Scan Order: score ASC by min LIMIT 5
        Cardinality: [64, 64, 64]
        Output Schema: public.rowset_pushdown_case.id INTEGER, public.rowset_pushdown_case.score INTEGER

