DROP TABLE IF EXISTS rowset_pushdown_dim;
DROP TABLE

DROP TABLE IF EXISTS rowset_pushdown_case;
DROP TABLE

CREATE TABLE rowset_pushdown_case(
    id INT,
    k INT,
    nullable_k INT,
    score INT,
    payload VARCHAR
);
CREATE TABLE

INSERT INTO rowset_pushdown_case
SELECT
    g,
    g % 10,
    CASE WHEN g % 8 = 0 THEN NULL ELSE g % 7 END,
    65 - g,
    'payload_' || CAST(g AS VARCHAR)
FROM generate_series(1, 64) AS t(g);
INSERT 0 64

CREATE TABLE rowset_pushdown_dim(k INT);
CREATE TABLE

INSERT INTO rowset_pushdown_dim VALUES (2), (5), (8);
INSERT 0 3

SELECT COUNT(*) FROM rowset_pushdown_case WHERE k = 3;
COUNT(*)
7

SELECT COUNT(*) FROM rowset_pushdown_case WHERE k >= 2 AND k < 5;
COUNT(*)
21

SELECT COUNT(*) FROM rowset_pushdown_case WHERE k IN (1, 4, 9);
COUNT(*)
20

SELECT COUNT(*) FROM rowset_pushdown_case WHERE nullable_k IS NULL;
COUNT(*)
8

EXPLAIN (VERBOSE)
SELECT COUNT(*) FROM rowset_pushdown_case WHERE k = 3;
QUERY PLAN
PROJECTION  (rows=1)
  Output: COUNT(*)
  Cardinality: [1, 1, 1]
  Output Schema: COUNT(*) BIGINT
  ->  AGGREGATE  (rows=1)
    Aggregates: count_star(*)
    Output: aggr_0
    Cardinality: [1, 1, 1]
    Output Schema: aggr_0 BIGINT
    ->  ROWSET_SCAN on public.rowset_pushdown_case  (rows=6)
      Columns: k
      Pushed Predicate: col#1 = 3
      Cardinality: [3, 6, 10]
      Output Schema: k INTEGER

EXPLAIN (VERBOSE)
SELECT payload FROM rowset_pushdown_case WHERE k = 3;
QUERY PLAN
PROJECTION  (rows=6)
  Output: payload
  Cardinality: [3, 6, 10]
  Output Schema: payload VARCHAR
  ->  ROWSET_SCAN on public.rowset_pushdown_case  (rows=6)
    Columns: k, payload
    Pushed Predicate: col#1 = 3
    Late Materialize: auto
    Cardinality: [3, 6, 10]
    Output Schema: k INTEGER, payload VARCHAR

