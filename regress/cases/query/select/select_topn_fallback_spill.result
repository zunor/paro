INSERT INTO topn_fallback_spill_case
SELECT g, 7001 - g
FROM generate_series(1, 7000) AS t(g);
INSERT 0 7000

EXPLAIN
SELECT id
FROM topn_fallback_spill_case
ORDER BY score DESC
LIMIT 3;
QUERY PLAN
PROJECTION  (rows=3)
  Output: id
  ->  TOP_N  (rows=3)
    Sort Key: #1 DESC NULLS FIRST
    Limit: 3
    ->  PROJECTION  (rows=7000)
      Output: id, __paro_hidden_1
      ->  ROWSET_SCAN on public.topn_fallback_spill_case  (rows=7000)
        Columns: id, score

SELECT id
FROM topn_fallback_spill_case
ORDER BY score DESC
LIMIT 3;
id
1
2
3

EXPLAIN
SELECT id
FROM topn_fallback_spill_case
ORDER BY id
LIMIT 5 OFFSET 6000;
QUERY PLAN
PROJECTION  (rows=5)
  Output: id
  ->  TOP_N  (rows=5)
    Sort Key: #1 ASC NULLS LAST
    Limit: 5
    ->  PROJECTION  (rows=7000)
      Output: id, __paro_hidden_1
      ->  ROWSET_SCAN on public.topn_fallback_spill_case  (rows=7000)
        Columns: id

SELECT id
FROM topn_fallback_spill_case
ORDER BY id
LIMIT 5 OFFSET 6000;
id
6001
6002
6003
6004
6005

