INSERT INTO topn_fallback_spill_case
SELECT g, 7001 - g
FROM generate_series(1, 7000) AS t(g);
INSERT 0 7000

EXPLAIN
SELECT id
FROM topn_fallback_spill_case
ORDER BY score DESC
LIMIT 3;
QUERY PLAN
PROJECTION  (rows=3)
  Output: id
  ->  TOP_N  (rows=3)
        Sort Key: score DESC NULLS FIRST
        Limit: 3
        ->  PROJECTION  (rows=7000)
              Output: id, score
              ->  ROWSET_SCAN on public.topn_fallback_spill_case
                    Columns: id, score

