CREATE TABLE cte_parallel_case(id INT, bucket INT, payload INT);
CREATE TABLE

INSERT INTO cte_parallel_case
SELECT g, g % 16, g % 100
FROM generate_series(1, 8000) AS t(g);
INSERT 0 8000

SET threads = 1;
SET

WITH base AS MATERIALIZED (
    SELECT id, bucket, payload FROM cte_parallel_case
)
SELECT count(*) AS total_rows, sum(payload) AS total_payload
FROM base;
total_rows	total_payload
8000	396000

WITH base AS MATERIALIZED (
    SELECT id, bucket, payload FROM cte_parallel_case
)
SELECT bucket, count(*) AS cnt
FROM base
WHERE bucket < 4
GROUP BY bucket
ORDER BY bucket;
bucket	cnt
0	500
1	500
2	500
3	500

SET threads = 4;
SET

WITH base AS MATERIALIZED (
    SELECT id, bucket, payload FROM cte_parallel_case
)
SELECT count(*) AS total_rows, sum(payload) AS total_payload
FROM base;
total_rows	total_payload
8000	396000

WITH base AS MATERIALIZED (
    SELECT id, bucket, payload FROM cte_parallel_case
)
SELECT bucket, count(*) AS cnt
FROM base
WHERE bucket < 4
GROUP BY bucket
ORDER BY bucket;
bucket	cnt
0	500
1	500
2	500
3	500

SET threads = DEFAULT;
