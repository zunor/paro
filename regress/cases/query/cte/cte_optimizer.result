EXPLAIN
WITH nums(v) AS (VALUES (1), (2), (3))
SELECT v FROM nums WHERE v > 1 ORDER BY v;
QUERY PLAN
ORDER_BY  (rows=1)
  Sort Key: v ASC NULLS LAST
  ->  PROJECTION  (rows=1)
    Output: v
    ->  FILTER  (rows=1)
      Filter: nums.v > 1
      ->  VALUES  (rows=3)

EXPLAIN
WITH nums(v) AS MATERIALIZED (VALUES (1), (2), (3))
SELECT v FROM nums WHERE v > 1 ORDER BY v;
QUERY PLAN
MATERIALIZED_CTE
  CTE Name: nums
  Materialization: MATERIALIZED
  Reference Count: 1
  ->  FILTER  (rows=1)
    Filter: nums.v > 1
    ->  VALUES  (rows=3)
  ->  ORDER_BY
    Sort Key: v ASC NULLS LAST
    ->  PROJECTION
      Output: v
      ->  FILTER
        Filter: nums.v > 1
        ->  CTE_SCAN
          CTE Index: 0
          Table Index: 8

EXPLAIN
WITH nums(v) AS NOT MATERIALIZED (VALUES (1), (2), (3))
SELECT SUM(a.v + b.v) AS total
FROM nums AS a
CROSS JOIN nums AS b;
QUERY PLAN
PROJECTION  (rows=1)
  Output: total
  ->  AGGREGATE  (rows=1)
    Aggregates: sum(+(a.v, b.v))
    ->  CROSS_PRODUCT  (rows=9)
      ->  PROJECTION  (rows=3)
        Output: v
        ->  VALUES  (rows=3)
      ->  PROJECTION  (rows=3)
        Output: v
        ->  VALUES  (rows=3)

WITH nums(v) AS NOT MATERIALIZED (VALUES (1), (2), (3))
SELECT SUM(a.v + b.v) AS total
FROM nums AS a
CROSS JOIN nums AS b;
total
36

WITH nums(v) AS MATERIALIZED (VALUES (1), (2), (3), (4)),
left_side(v) AS (SELECT v FROM nums WHERE v >= 2),
right_side(v) AS (SELECT v FROM nums WHERE v <= 3)
SELECT l.v AS left_v, r.v AS right_v
FROM left_side AS l
JOIN right_side AS r ON l.v = r.v
ORDER BY left_v, right_v;
left_v	right_v
2	2
3	3
