EXPLAIN
WITH nums(v) AS (VALUES (1), (2), (3))
SELECT v FROM nums WHERE v > 1 ORDER BY v;
QUERY PLAN
PROJECTION  (rows=1)
  Output: v
  ->  ORDER_BY  (rows=1)
        Sort Key: col0 ASC NULLS LAST
        ->  PROJECTION  (rows=1)
              Output: col0, col0
              ->  PROJECTION  (rows=1)
                    Output: col0
                    ->  FILTER  (rows=1)
                          Filter: (col0 > 1)
                          ->  EXPRESSION_SCAN  (rows=3)

EXPLAIN
WITH nums(v) AS MATERIALIZED (VALUES (1), (2), (3))
SELECT v FROM nums WHERE v > 1 ORDER BY v;
QUERY PLAN
CTE
  CTE Name: nums
  Materialization: MATERIALIZED
  Reference Count: 1
  ->  FILTER  (rows=1)
        Filter: (col0 > 1)
        ->  EXPRESSION_SCAN  (rows=3)
  ->  PROJECTION
        Output: v
        ->  ORDER_BY
              Sort Key: v ASC NULLS LAST
              ->  PROJECTION
                    Output: v, v
                    ->  FILTER
                          Filter: (v > 1)
                          ->  CTE_SCAN
                                CTE Name: nums

EXPLAIN
WITH nums(v) AS NOT MATERIALIZED (VALUES (1), (2), (3))
SELECT SUM(a.v + b.v) AS total
FROM nums AS a
CROSS JOIN nums AS b;
QUERY PLAN
PROJECTION  (rows=1)
  Output: sum
  ->  UNGROUPED_AGGREGATE  (rows=1)
        Aggregates: SUM(+(expr_1, expr_1))
        ->  PROJECTION
              Output: +(expr_1, expr_1)
              ->  CROSS_PRODUCT  (rows=1000000)
                    Join Type: CROSS
                    ->  PROJECTION
                          Output: col0
                          ->  EXPRESSION_SCAN
                    ->  PROJECTION
                          Output: col0
                          ->  EXPRESSION_SCAN

WITH nums(v) AS NOT MATERIALIZED (VALUES (1), (2), (3))
SELECT SUM(a.v + b.v) AS total
FROM nums AS a
CROSS JOIN nums AS b;
total
36

WITH nums(v) AS MATERIALIZED (VALUES (1), (2), (3), (4)),
left_side(v) AS (SELECT v FROM nums WHERE v >= 2),
right_side(v) AS (SELECT v FROM nums WHERE v <= 3)
SELECT l.v AS left_v, r.v AS right_v
FROM left_side AS l
JOIN right_side AS r ON l.v = r.v
ORDER BY left_v, right_v;
left_v	right_v
2	2
3	3
