EXPLAIN
WITH nums(v) AS (VALUES (1), (2), (3))
SELECT v FROM nums WHERE v > 1 ORDER BY v;
QUERY PLAN
PROJECTION  (rows=1)
  Output: v
  ->  ORDER_BY  (rows=1)
    Sort Key: #1 ASC NULLS LAST
    ->  PROJECTION  (rows=1)
      Output: v, __paro_hidden_1
      ->  PROJECTION  (rows=1)
        Output: expr_1
        ->  FILTER  (rows=1)
          Filter: #0 > 1
          ->  VALUES  (rows=3)

EXPLAIN
WITH nums(v) AS MATERIALIZED (VALUES (1), (2), (3))
SELECT v FROM nums WHERE v > 1 ORDER BY v;
QUERY PLAN
MATERIALIZED_CTE
  CTE Name: nums
  Materialization: MATERIALIZED
  Reference Count: 1
  ->  FILTER  (rows=1)
    Filter: #0 > 1
    ->  VALUES  (rows=3)
  ->  PROJECTION
    Output: v
    ->  ORDER_BY
      Sort Key: #1 ASC NULLS LAST
      ->  PROJECTION
        Output: v, __paro_hidden_1
        ->  FILTER
          Filter: #0 > 1
          ->  CTE_SCAN
            CTE Index: 0
            Table Index: 8

EXPLAIN
WITH nums(v) AS NOT MATERIALIZED (VALUES (1), (2), (3))
SELECT SUM(a.v + b.v) AS total
FROM nums AS a
CROSS JOIN nums AS b;
QUERY PLAN
PROJECTION  (rows=1)
  Output: total
  ->  AGGREGATE  (rows=1)
    Aggregates: sum(+(#0, #1))
    Output: aggr_0
    ->  CROSS_PRODUCT  (rows=1000000)
      ->  PROJECTION
        Output: expr_1
        ->  VALUES
      ->  PROJECTION
        Output: expr_1
        ->  VALUES

WITH nums(v) AS NOT MATERIALIZED (VALUES (1), (2), (3))
SELECT SUM(a.v + b.v) AS total
FROM nums AS a
CROSS JOIN nums AS b;
total
36

WITH nums(v) AS MATERIALIZED (VALUES (1), (2), (3), (4)),
left_side(v) AS (SELECT v FROM nums WHERE v >= 2),
right_side(v) AS (SELECT v FROM nums WHERE v <= 3)
SELECT l.v AS left_v, r.v AS right_v
FROM left_side AS l
JOIN right_side AS r ON l.v = r.v
ORDER BY left_v, right_v;
left_v	right_v
2	2
3	3
