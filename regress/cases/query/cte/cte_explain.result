  Materialization: MATERIALIZED
  Reference Count: 3
  ->  VALUES  (rows=5)
  ->  ORDER_BY
    Sort Key: p.id ASC NULLS LAST, p.peer_id ASC NULLS LAST
    ->  PROJECTION
      Output: p.id, p.peer_id, a.total
      ->  HASH_JOIN
        Join Type: INNER
        Join Condition: p.grp = a.grp
        ->  PROJECTION
          Output: id, peer_id, grp
          ->  FILTER
            Filter: l.id < r.id
            ->  HASH_JOIN
              Join Type: INNER
              Join Condition: l.grp = r.grp
              ->  CTE_SCAN
                CTE Index: 0
                Table Index: 16
              ->  CTE_SCAN
                CTE Index: 0
                Table Index: 17
        ->  PROJECTION
          Output: grp, total
          ->  AGGREGATE
            Group Key: base.grp
            Aggregates: sum(base.amount)
            ->  CTE_SCAN
              CTE Index: 0
              Table Index: 25

-- @normalize explain_operator_timing,explain_summary_timing
EXPLAIN ANALYZE
WITH base(id, grp, amount) AS MATERIALIZED (
    VALUES
        (1, 'east', 10),
        (2, 'east', 20),
        (3, 'west', 15),
        (4, 'west', 30),
        (5, 'north', 5)
),
agg AS (
    SELECT grp, SUM(amount) AS total
    FROM base
    GROUP BY grp
),
peers AS (
    SELECT l.id, r.id AS peer_id, l.grp
    FROM base AS l
    JOIN base AS r ON l.grp = r.grp AND l.id < r.id
)
SELECT p.id, p.peer_id, a.total
FROM peers AS p
JOIN agg AS a ON a.grp = p.grp
ORDER BY p.id, p.peer_id;
