WITH base(id, grp, amount) AS MATERIALIZED (
    VALUES
        (1, 'east', 10),
        (2, 'east', 20),
        (3, 'west', 15),
        (4, 'west', 30),
        (5, 'north', 5)
),
agg AS (
    SELECT grp, SUM(amount) AS total
    FROM base
    GROUP BY grp
),
peers AS (
    SELECT l.id, r.id AS peer_id, l.grp
    FROM base AS l
    JOIN base AS r ON l.grp = r.grp AND l.id < r.id
)
SELECT p.id, p.peer_id, a.total
FROM peers AS p
JOIN agg AS a ON a.grp = p.grp
ORDER BY p.id, p.peer_id;
p.id	p.peer_id	a.total
1	2	30
3	4	45

-- @normalize explain_operator_timing,explain_summary_timing
EXPLAIN ANALYZE
WITH RECURSIVE
edges(src, dst) AS (
    VALUES (1, 2), (1, 3), (2, 4), (3, 5), (5, 6)
),
walk(node, depth) AS (
    VALUES (1, 0)
    UNION ALL
    SELECT e.dst, w.depth + 1
    FROM walk AS w
    JOIN edges AS e ON e.src = w.node
    WHERE w.depth < 2
)
SELECT node, depth FROM walk ORDER BY depth, node;
QUERY PLAN
PROJECTION  (rows=1) (actual time=<time-range> rows=5 loops=1)
  Output: node, depth
  ->  ORDER_BY  (rows=1) (actual time=<time-range> rows=10 loops=5)
        Sort Key: depth ASC NULLS LAST, node ASC NULLS LAST
        Sort Method: quicksort
        Spilled: false
        Peak Memory: 0 B
        ->  PROJECTION  (rows=1) (actual time=<time-range> rows=5 loops=3)
              Output: node, depth, depth, node
              ->  PROJECTION  (rows=1) (actual time=<time-range> rows=5 loops=3)
                    Output: node, depth
                    ->  RECURSIVE_CTE  (rows=1) (actual time=<time-range> rows=10 loops=7)
                          CTE Name: walk
                          Set Operation: UNION ALL
                          Iterations: 2
                          ->  EXPRESSION_SCAN  (rows=1) (actual time=<time-range> rows=1 loops=2)
                          ->  PROJECTION (actual time=<time-range> rows=4 loops=2)
                                Output: expr_2, +(depth, 1)
                                ->  FILTER (actual time=<time-range> rows=4 loops=2)
                                      Filter: (node = expr_1)
                                      ->  CROSS_PRODUCT  (rows=1000000) (actual time=<time-range> rows=30 loops=5)
                                            Join Type: CROSS
                                            ->  FILTER (actual time=<time-range> rows=3 loops=3)
                                                  Filter: (depth < 2)
                                                  ->  CTE_SCAN (actual time=<time-range> rows=5 loops=6)
                                                        CTE Name: walk
                                            ->  PROJECTION (actual time=<time-range> rows=15 loops=3)
                                                  Output: col0, col1
                                                  ->  EXPRESSION_SCAN (actual time=<time-range> rows=15 loops=6)
Execution Time: <time-ms>
Rows Returned: 5
