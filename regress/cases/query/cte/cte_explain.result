  Materialized Rows: 5
  ->  EXPRESSION_SCAN  (rows=5) (actual time=<time-range> rows=5 loops=2)
  ->  PROJECTION (actual time=<time-range> rows=2 loops=1)
        Output: p.id, p.peer_id, a.total
        ->  ORDER_BY (actual time=<time-range> rows=4 loops=3)
              Sort Key: expr_1 ASC NULLS LAST, expr_2 ASC NULLS LAST
              Sort Method: quicksort
              Spilled: false
              Peak Memory: 0 B
              ->  PROJECTION (actual time=<time-range> rows=2 loops=1)
                    Output: expr_1, expr_2, expr_2, expr_1, expr_2
                    ->  FILTER (actual time=<time-range> rows=2 loops=1)
                          Filter: (expr_3 = expr_1)
                          ->  CROSS_PRODUCT  (rows=1000000) (actual time=<time-range> rows=9 loops=2)
                                Join Type: CROSS
                                ->  PROJECTION (actual time=<time-range> rows=2 loops=1)
                                      Output: id, id, grp
                                      ->  PROJECTION (actual time=<time-range> rows=2 loops=1)
                                            Output: id, id, grp
                                            ->  FILTER (actual time=<time-range> rows=2 loops=1)
                                                  Filter: ((grp = grp) AND (id < id))
                                                  ->  CROSS_PRODUCT (actual time=<time-range> rows=30 loops=2)
                                                        Join Type: CROSS
                                                        ->  CTE_SCAN (actual time=<time-range> rows=5 loops=2)
                                                              CTE Name: base
                                                        ->  CTE_SCAN (actual time=<time-range> rows=5 loops=2)
                                                              CTE Name: base
                                ->  PROJECTION (actual time=<time-range> rows=3 loops=1)
                                      Output: ref_2, sum
                                      ->  PROJECTION (actual time=<time-range> rows=3 loops=1)
                                            Output: ref_2, sum
                                            ->  HASH_GROUP_BY (actual time=<time-range> rows=8 loops=3)
                                                  Group Key: grp
                                                  Aggregates: SUM(amount)
