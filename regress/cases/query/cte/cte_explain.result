EXPLAIN
WITH base(id, grp, amount) AS MATERIALIZED (
    VALUES
        (1, 'east', 10),
        (2, 'east', 20),
        (3, 'west', 15),
        (4, 'west', 30),
        (5, 'north', 5)
),
agg AS (
    SELECT grp, SUM(amount) AS total
    FROM base
    GROUP BY grp
),
peers AS (
    SELECT l.id, r.id AS peer_id, l.grp
    FROM base AS l
    JOIN base AS r ON l.grp = r.grp AND l.id < r.id
)
SELECT p.id, p.peer_id, a.total
FROM peers AS p
JOIN agg AS a ON a.grp = p.grp
ORDER BY p.id, p.peer_id;
QUERY PLAN
CTE
  CTE Name: base
  Materialization: MATERIALIZED
  Reference Count: 3
  ->  EXPRESSION_SCAN  (rows=5)
  ->  PROJECTION
        Output: p.id, p.peer_id, a.total
        ->  ORDER_BY
              Sort Key: expr_1 ASC NULLS LAST, expr_2 ASC NULLS LAST
              ->  PROJECTION
                    Output: expr_1, expr_2, expr_2, expr_1, expr_2
                    ->  FILTER
                          Filter: (expr_3 = expr_1)
                          ->  CROSS_PRODUCT  (rows=1000000)
                                Join Type: CROSS
                                ->  PROJECTION
                                      Output: id, id, grp
                                      ->  PROJECTION
                                            Output: id, id, grp
                                            ->  FILTER
                                                  Filter: ((grp = grp) AND (id < id))
                                                  ->  CROSS_PRODUCT
                                                        Join Type: CROSS
                                                        ->  CTE_SCAN
                                                              CTE Name: base
                                                        ->  CTE_SCAN
                                                              CTE Name: base
                                ->  PROJECTION
                                      Output: ref_2, sum
                                      ->  PROJECTION
                                            Output: ref_2, sum
                                            ->  HASH_GROUP_BY
                                                  Group Key: grp
                                                  Aggregates: SUM(amount)
                                                  ->  PROJECTION
                                                        Output: grp, amount
                                                        ->  CTE_SCAN
                                                              CTE Name: base

-- @normalize explain_operator_timing,explain_summary_timing
EXPLAIN ANALYZE
WITH base(id, grp, amount) AS MATERIALIZED (
    VALUES
        (1, 'east', 10),
        (2, 'east', 20),
        (3, 'west', 15),
        (4, 'west', 30),
        (5, 'north', 5)
),
agg AS (
    SELECT grp, SUM(amount) AS total
    FROM base
    GROUP BY grp
),
peers AS (
    SELECT l.id, r.id AS peer_id, l.grp
    FROM base AS l
    JOIN base AS r ON l.grp = r.grp AND l.id < r.id
)
SELECT p.id, p.peer_id, a.total
FROM peers AS p
JOIN agg AS a ON a.grp = p.grp
ORDER BY p.id, p.peer_id;
