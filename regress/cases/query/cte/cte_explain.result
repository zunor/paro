EXPLAIN
WITH base(id, grp, amount) AS MATERIALIZED (
    VALUES
        (1, 'east', 10),
        (2, 'east', 20),
        (3, 'west', 15),
        (4, 'west', 30),
        (5, 'north', 5)
),
agg AS (
    SELECT grp, SUM(amount) AS total
    FROM base
    GROUP BY grp
),
peers AS (
    SELECT l.id, r.id AS peer_id, l.grp
    FROM base AS l
    JOIN base AS r ON l.grp = r.grp AND l.id < r.id
)
SELECT p.id, p.peer_id, a.total
FROM peers AS p
JOIN agg AS a ON a.grp = p.grp
ORDER BY p.id, p.peer_id;
QUERY PLAN
MATERIALIZED_CTE
  CTE Name: base
  Materialization: MATERIALIZED
  Reference Count: 3
  ->  VALUES  (rows=5)
  ->  ORDER_BY
    Sort Key: #0 ASC NULLS LAST, #1 ASC NULLS LAST
    ->  PROJECTION
      Output: p.id, p.peer_id, a.total
      ->  FILTER
        Filter: #2 = #3
        ->  CROSS_PRODUCT  (rows=1000000)
          ->  PROJECTION
            Output: expr_1, expr_2, expr_3
            ->  PROJECTION
              Output: l.id, peer_id, l.grp
              ->  FILTER
                Filter: #1 = #4 AND #0 < #3
                ->  CROSS_PRODUCT
                  ->  CTE_SCAN
                    CTE Index: 0
                    Table Index: 16
                  ->  CTE_SCAN
                    CTE Index: 0
                    Table Index: 17
          ->  PROJECTION
            Output: expr_1, expr_2
            ->  PROJECTION
              Output: grp, total
              ->  AGGREGATE
                Group Key: #1
                Aggregates: sum(#2)
                Output: aggr_0, aggr_1
                ->  CTE_SCAN
                  CTE Index: 0
                  Table Index: 25

