-- @normalize explain_operator_timing,explain_summary_timing
EXPLAIN ANALYZE
WITH RECURSIVE
edges(src, dst) AS (
    VALUES (1, 2), (1, 3), (2, 4), (3, 5), (5, 6)
),
walk(node, depth) AS (
    VALUES (1, 0)
    UNION ALL
    SELECT e.dst, w.depth + 1
    FROM walk AS w
    JOIN edges AS e ON e.src = w.node
    WHERE w.depth < 2
)
SELECT node, depth FROM walk ORDER BY depth, node;
