EXPLAIN
WITH base(id, grp, amount) AS MATERIALIZED (
    VALUES
        (1, 'east', 10),
        (2, 'east', 20),
        (3, 'west', 15),
        (4, 'west', 30),
        (5, 'north', 5)
),
agg AS (
    SELECT grp, SUM(amount) AS total
    FROM base
    GROUP BY grp
),
peers AS (
    SELECT l.id, r.id AS peer_id, l.grp
    FROM base AS l
    JOIN base AS r ON l.grp = r.grp AND l.id < r.id
)
SELECT p.id, p.peer_id, a.total
FROM peers AS p
JOIN agg AS a ON a.grp = p.grp
ORDER BY p.id, p.peer_id;
QUERY PLAN
MATERIALIZED_CTE  (rows=1)
  CTE Name: base
  Materialization: MATERIALIZED
  Reference Count: 3
  ->  VALUES  (rows=5)
  ->  MATERIALIZED_CTE  (rows=1)
    CTE Name: agg
    Materialization: MATERIALIZED
    Reference Count: 1
    ->  PROJECTION  (rows=3)
      Output: grp, total
      ->  AGGREGATE  (rows=3)
        Group Key: base.grp
        Aggregates: sum(base.amount)
        ->  CTE_SCAN  (rows=5)
          CTE Index: 0
          Table Index: 25
    ->  MATERIALIZED_CTE  (rows=1)
      CTE Name: peers
      Materialization: MATERIALIZED
      Reference Count: 1
      ->  PROJECTION  (rows=1)
        Output: l.id, peer_id, l.grp
        ->  FILTER  (rows=1)
          Filter: l.id < r.id
          ->  HASH_JOIN  (rows=3)
            Join Type: INNER
            Join Condition: l.grp = r.grp
            ->  CTE_SCAN  (rows=5)
              CTE Index: 0
              Table Index: 16
            ->  CTE_SCAN  (rows=5)
              CTE Index: 0
              Table Index: 17
      ->  ORDER_BY  (rows=1)
        Sort Key: p.id ASC NULLS LAST, p.peer_id ASC NULLS LAST
        ->  PROJECTION  (rows=1)
          Output: p.id, p.peer_id, a.total
          ->  HASH_JOIN  (rows=1)
            Join Type: INNER
            Join Condition: a.grp = p.grp
            ->  CTE_SCAN  (rows=3)
              CTE Index: 1
              Table Index: 26
            ->  CTE_SCAN  (rows=1)
              CTE Index: 2
              Table Index: 18

