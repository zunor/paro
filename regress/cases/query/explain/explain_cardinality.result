INSERT 0 6

EXPLAIN (VERBOSE)
SELECT id
FROM explain_cardinality_case
WHERE score >= 20
ORDER BY score DESC, id
LIMIT 2;
QUERY PLAN
PROJECTION  (rows=2)
  Output: id
  Cardinality: [0, 2, 2]
  Output Schema: id INTEGER
  ->  TOP_N  (rows=2)
        Sort Key: score DESC NULLS FIRST, id ASC NULLS LAST
        Limit: 2
        Cardinality: [0, 2, 2]
        Output Schema: id INTEGER, col_2 INTEGER, col_3 INTEGER
        ->  PROJECTION  (rows=2)
              Output: id, score, id
              Cardinality: [0, 2, 3]
              Output Schema: id INTEGER, col_2 INTEGER, col_3 INTEGER
              ->  ROWSET_SCAN on public.explain_cardinality_case
                    Columns: id, score
                    Filter: score >= 20
                    Output Schema: id INTEGER, score INTEGER

-- @query json
EXPLAIN
SELECT id
FROM explain_cardinality_case
WHERE score >= 20
ORDER BY score DESC, id
LIMIT 2
FORMAT JSON;
QUERY PLAN
{\n  "detail": {\n    "memory": true,\n    "summary": true,\n    "timing": true,\n    "verbose": false\n  },\n  "format": "json",\n  "format_version": 1,\n  "mode": "plan",\n  "plan": {\n    "children": [\n      {\n        "children": [\n          {\n            "children": [\n              {\n                "node_id": 2,\n                "operator": "ROWSET_SCAN",\n                "output_names": [\n                  "id",\n                  "score"\n                ],\n                "properties": {\n                  "Columns": [\n                    "id",\n                    "score"\n                  ],\n                  "Filter": "score >= 20"\n                },\n                "relation": "public.explain_cardinality_case"\n              }\n            ],\n            "estimated_cardinality": {\n              "expected": 2,\n              "max": 3,\n              "min": 0\n            },\n            "estimated_rows": 2,\n            "node_id": 3,\n            "operator": "PROJECTION",\n            "output_names": [\n              "id",\n              "score",\n              "id"\n            ],\n            "properties": {\n              "Output": [\n                "id",\n                "score",\n                "id"\n              ]\n            }\n          }\n        ],\n        "estimated_cardinality": {\n          "expected": 2,\n          "max": 2,\n          "min": 0\n        },\n        "estimated_rows": 2,\n        "node_id": 4,\n        "operator": "TOP_N",\n        "output_names": [\n          "id"\n        ],\n        "properties": {\n          "Limit": 2,\n          "Sort Key": "score DESC NULLS FIRST, id ASC NULLS LAST"\n        }\n      }\n    ],\n    "estimated_cardinality": {\n      "expected": 2,\n      "max": 2,\n      "min": 0\n    },\n    "estimated_rows": 2,\n    "node_id": 5,\n    "operator": "PROJECTION",\n    "output_names": [\n      "id"\n    ],\n    "properties": {\n      "Output": [\n        "id"\n      ]\n    }\n  }\n}

