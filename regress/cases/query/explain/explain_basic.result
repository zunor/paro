PROJECTION  (rows=3)
  Output: id, id
  Cardinality: [1, 3, 4]
  Output Schema: l.id INTEGER, r.id INTEGER
  ->  PIECEWISE_MERGE_JOIN  (rows=0)
        Join Type: INNER
        Join Condition: id < id
        Cardinality: [0, 0, 0]
        Output Schema: id INTEGER, id INTEGER
        ->  ROWSET_SCAN on public.explain_piecewise_left l
              Columns: id
              Output Schema: id INTEGER
        ->  ROWSET_SCAN on public.explain_piecewise_right r
              Columns: id
              Output Schema: id INTEGER

