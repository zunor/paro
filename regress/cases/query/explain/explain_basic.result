EXPLAIN
SELECT *
FROM explain_piecewise_left AS l
JOIN explain_piecewise_right AS r ON l.id < r.id;
QUERY PLAN
PROJECTION  (rows=3)
  Output: id, id
  ->  PIECEWISE_MERGE_JOIN  (rows=0)
        Join Type: INNER
        Join Condition: id < id
        ->  ROWSET_SCAN on public.explain_piecewise_left l
              Columns: id
        ->  ROWSET_SCAN on public.explain_piecewise_right r
              Columns: id

