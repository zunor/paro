DROP TABLE IF EXISTS explain_ie_left;
DROP TABLE

DROP TABLE IF EXISTS explain_ie_right;
DROP TABLE

CREATE TABLE explain_ie_left (x INT);
CREATE TABLE

CREATE TABLE explain_ie_right (lo INT, hi INT);
CREATE TABLE

INSERT INTO explain_ie_left VALUES (2), (5), (9);
INSERT 0 3

INSERT INTO explain_ie_right VALUES (1, 3), (4, 6), (7, 10);
INSERT 0 3

EXPLAIN
SELECT *
FROM explain_ie_left AS l
JOIN explain_ie_right AS r ON l.x BETWEEN r.lo AND r.hi;
QUERY PLAN
PROJECTION  (rows=1)
  Output: x, lo, hi
  ->  IE_JOIN  (rows=0)
        Join Type: INNER
        Join Condition: lo <= x, hi >= x
        ->  ROWSET_SCAN on public.explain_ie_right r
              Columns: lo, hi
        ->  ROWSET_SCAN on public.explain_ie_left l
              Columns: x

EXPLAIN (VERBOSE)
SELECT *
FROM explain_ie_left AS l
JOIN explain_ie_right AS r ON l.x BETWEEN r.lo AND r.hi;
QUERY PLAN
PROJECTION  (rows=1)
  Output: x, lo, hi
  Cardinality: [0, 1, 1]
  Output Schema: l.x INTEGER, r.lo INTEGER, r.hi INTEGER
  ->  IE_JOIN  (rows=0)
        Join Type: INNER
        Join Condition: lo <= x, hi >= x
        Cardinality: [0, 0, 0]
        Output Schema: lo INTEGER, hi INTEGER, x INTEGER
        ->  ROWSET_SCAN on public.explain_ie_right r
              Columns: lo, hi
              Output Schema: lo INTEGER, hi INTEGER
        ->  ROWSET_SCAN on public.explain_ie_left l
              Columns: x
              Output Schema: x INTEGER

