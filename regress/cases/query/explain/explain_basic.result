DROP TABLE IF EXISTS explain_topn_rt;
DROP TABLE

CREATE TABLE explain_topn_rt (id INT, score INT);
CREATE TABLE

INSERT INTO explain_topn_rt VALUES (1, 10), (2, 30), (3, 20), (4, 40);
INSERT 0 4

EXPLAIN
SELECT id
FROM explain_topn_rt
ORDER BY score DESC
LIMIT 2;
QUERY PLAN
PROJECTION  (rows=2)
  Output: id
  ->  TOP_N  (rows=2)
        Sort Key: score DESC NULLS FIRST
        Limit: 2
        ->  PROJECTION  (rows=4)
              Output: id, score
              ->  ROWSET_SCAN on public.explain_topn_rt
                    Columns: id, score

EXPLAIN
SELECT id
FROM explain_topn_rt
ORDER BY score DESC
LIMIT 5 OFFSET 6000;
QUERY PLAN
PROJECTION  (rows=0)
  Output: id
  ->  STREAMING_LIMIT
        Limit: 5
        Offset: 6000
        ->  ORDER_BY
              Sort Key: score DESC NULLS FIRST
              ->  PROJECTION  (rows=4)
                    Output: id, score
                    ->  ROWSET_SCAN on public.explain_topn_rt
                          Columns: id, score

DROP TABLE explain_topn_rt;
DROP TABLE

