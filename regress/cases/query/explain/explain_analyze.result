DROP TABLE IF EXISTS explain_analyze_rt;
DROP TABLE

CREATE TABLE explain_analyze_rt (id INT, score INT);
CREATE TABLE

INSERT INTO explain_analyze_rt VALUES (1, 10), (2, 30), (3, 20);
INSERT 0 3

-- @normalize explain_operator_timing,explain_summary_timing
EXPLAIN ANALYZE
SELECT id
FROM explain_analyze_rt
WHERE score >= 20
ORDER BY score DESC;
QUERY PLAN
PIPELINE 0
  SOURCE #0 ROWSET_SCAN (actual time=<time-range> rows=3 loops=2)
  TRANSFORM #1 FILTER (actual time=<time-range> rows=2 loops=1)
  TRANSFORM #2 PROJECTION (actual time=<time-range> rows=2 loops=1)
  SINK #3 SORT_BUILD (actual time=<time-range> rows=2 loops=1 peak_memory_bytes=262155)
PIPELINE 1
  SOURCE #4 SORT_EMIT (actual time=<time-range> rows=2 loops=2)
  TRANSFORM #5 PROJECTION (actual time=<time-range> rows=2 loops=1)
  SINK #6 CLIENT_RESULT (actual time=<time-range> rows=2 loops=1)
Execution Time: <time-ms>
Rows Returned: 2

