-- @normalize explain_operator_timing,explain_summary_timing
EXPLAIN ANALYZE SELECT 1;
QUERY PLAN
PROJECTION (actual time=<time-range> rows=1 loops=1)
  Output: 1
  ->  DUMMY_SCAN (actual time=<time-range> rows=1 loops=2)
Execution Time: <time-ms>
Rows Returned: 1

DROP TABLE IF EXISTS explain_analyze_rt;
DROP TABLE

CREATE TABLE explain_analyze_rt (id INT, score INT);
CREATE TABLE

INSERT INTO explain_analyze_rt VALUES (1, 10), (2, 30), (3, 20);
INSERT 0 3

-- @normalize explain_operator_timing,explain_summary_timing
EXPLAIN ANALYZE
SELECT id
FROM explain_analyze_rt
WHERE score >= 20
ORDER BY score DESC;
QUERY PLAN
PROJECTION  (rows=1) (actual time=<time-range> rows=2 loops=1)
  Output: id
  ->  ORDER_BY  (rows=1) (actual time=<time-range> rows=4 loops=3)
        Sort Key: score DESC NULLS FIRST
        Sort Method: quicksort
        Spilled: false
        Peak Memory: 0 B
        ->  PROJECTION  (rows=1) (actual time=<time-range> rows=2 loops=1)
              Output: id, score
              ->  ROWSET_SCAN on public.explain_analyze_rt (actual time=<time-range> rows=2 loops=2)
                    Columns: id, score
                    Filter: score >= 20
Execution Time: <time-ms>
Rows Returned: 2

-- @query json
-- @normalize explain_operator_timing,explain_summary_timing
