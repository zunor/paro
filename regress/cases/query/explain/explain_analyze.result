SELECT id
FROM explain_analyze_rt
WHERE score >= 20
ORDER BY score DESC
FORMAT JSON;
QUERY PLAN
{\n  "detail": {\n    "memory": true,\n    "summary": true,\n    "timing": true,\n    "verbose": false\n  },\n  "format": "json",\n  "format_version": 1,\n  "mode": "analyze",\n  "plan": {\n    "actual": {\n      "loops": 1,\n      "rows": 2,\n      "startup_time_ms": 0.0,\n      "total_time_ms": 0.0\n    },\n    "children": [\n      {\n        "actual": {\n          "loops": 3,\n          "peak_memory_bytes": 0,\n          "rows": 4,\n          "spilled": false,\n          "startup_time_ms": 0.0,\n          "total_time_ms": 0.0\n        },\n        "children": [\n          {\n            "actual": {\n              "loops": 1,\n              "rows": 2,\n              "startup_time_ms": 0.0,\n              "total_time_ms": 0.0\n            },\n            "children": [\n              {\n                "actual": {\n                  "loops": 2,\n                  "rows": 2,\n                  "startup_time_ms": 0.0,\n                  "total_time_ms": 0.0\n                },\n                "node_id": 2,\n                "operator": "ROWSET_SCAN",\n                "output_names": [\n                  "id",\n                  "score"\n                ],\n                "properties": {\n                  "Columns": [\n                    "id",\n                    "score"\n                  ],\n                  "Filter": "score >= 20"\n                },\n                "relation": "public.explain_analyze_rt"\n              }\n            ],\n            "estimated_cardinality": {\n              "expected": 1,\n              "max": 2,\n              "min": 0\n            },\n            "estimated_rows": 1,\n            "node_id": 3,\n            "operator": "PROJECTION",\n            "output_names": [\n              "id",\n              "score"\n            ],\n            "properties": {\n              "Output": [\n                "id",\n                "score"\n              ]\n            }\n          }\n        ],\n        "estimated_cardinality": {\n          "expected": 1,\n          "max": 2,\n          "min": 0\n        },\n        "estimated_rows": 1,\n        "node_id": 4,\n        "operator": "ORDER_BY",\n        "output_names": [\n          "id"\n        ],\n        "properties": {\n          "Peak Memory": 0,\n          "Sort Key": "score DESC NULLS FIRST",\n          "Sort Method": "quicksort",\n          "Spilled": false\n        }\n      }\n    ],\n    "estimated_cardinality": {\n      "expected": 1,\n      "max": 2,\n      "min": 0\n    },\n    "estimated_rows": 1,\n    "node_id": 5,\n    "operator": "PROJECTION",\n    "output_names": [\n      "id"\n    ],\n    "properties": {\n      "Output": [\n        "id"\n      ]\n    }\n  },\n  "summary": {\n    "Execution Time": "<time-ms>",\n    "Rows Returned": 2\n  }\n}

DROP TABLE explain_analyze_rt;
DROP TABLE

DROP TABLE IF EXISTS explain_analyze_topn_rt;
DROP TABLE

CREATE TABLE explain_analyze_topn_rt (id INT, score INT);
CREATE TABLE

INSERT INTO explain_analyze_topn_rt
SELECT g, 7001 - g
FROM generate_series(1, 7000) AS t(g);
INSERT 0 7000

-- @normalize explain_operator_timing,explain_summary_timing
EXPLAIN ANALYZE
SELECT id
FROM explain_analyze_topn_rt
ORDER BY score DESC
LIMIT 3;
QUERY PLAN
PROJECTION  (rows=3) (actual time=<time-range> rows=3 loops=1)
  Output: id
  ->  TOP_N  (rows=3) (actual time=<time-range> rows=7003 loops=4)
        Sort Key: score DESC NULLS FIRST
        Limit: 3
        Peak Memory: 16.2 kB
        ->  PROJECTION  (rows=7000) (actual time=<time-range> rows=7000 loops=2)
              Output: id, score
              ->  ROWSET_SCAN on public.explain_analyze_topn_rt (actual time=<time-range> rows=7000 loops=3)
                    Columns: id, score
Execution Time: <time-ms>
Rows Returned: 3

SET temp_directory = '/tmp/paro_regress_explain_topn';
SET

SET force_external = true;
SET

-- @normalize explain_operator_timing,explain_operator_counters,explain_summary_timing,explain_runtime_bytes
EXPLAIN ANALYZE
SELECT id
FROM explain_analyze_topn_rt
ORDER BY score DESC
LIMIT 3;
QUERY PLAN
PROJECTION  (rows=3) (actual time=<time-range> rows=<rows> loops=<loops>)
  Output: id
  ->  STREAMING_LIMIT (actual time=<time-range> rows=<rows> loops=<loops>)
        Limit: 3
        ->  ORDER_BY (actual time=<time-range> rows=<rows> loops=<loops>)
              Sort Key: score DESC NULLS FIRST
              Sort Method: external merge
              Spilled: true
              Peak Memory: <bytes>
              ->  PROJECTION  (rows=7000) (actual time=<time-range> rows=<rows> loops=<loops>)
                    Output: id, score
                    ->  ROWSET_SCAN on public.explain_analyze_topn_rt (actual time=<time-range> rows=<rows> loops=<loops>)
                          Columns: id, score
Execution Time: <time-ms>
Rows Returned: 3

SET force_external = DEFAULT;
SET

SET temp_directory = DEFAULT;
SET

