CREATE TABLE explain_analyze_topn_rt (id INT, score INT);
CREATE TABLE

INSERT INTO explain_analyze_topn_rt
SELECT g, 7001 - g
FROM generate_series(1, 7000) AS t(g);
INSERT 0 7000

-- @normalize explain_operator_timing,explain_summary_timing
EXPLAIN ANALYZE
SELECT id
FROM explain_analyze_topn_rt
ORDER BY score DESC
LIMIT 3;
QUERY PLAN
PIPELINE 0
  SOURCE #0 ROWSET_SCAN (actual time=<time-range> rows=7000 loops=3)
  TRANSFORM #1 PROJECTION (actual time=<time-range> rows=7000 loops=2)
  SINK #2 TOP_N_BUILD (actual time=<time-range> rows=7000 loops=2)
PIPELINE 1
  SOURCE #3 TOP_N_EMIT (actual time=<time-range> rows=3 loops=2)
  TRANSFORM #4 PROJECTION (actual time=<time-range> rows=3 loops=1)
  SINK #5 CLIENT_RESULT (actual time=<time-range> rows=3 loops=1)
Execution Time: <time-ms>
Rows Returned: 3

