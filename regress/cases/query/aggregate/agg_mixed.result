DROP TABLE IF EXISTS agg_m_dim;
DROP TABLE

CREATE TABLE agg_m_dim (
    dim_id INT,
    category VARCHAR,
    flag BOOLEAN
);
CREATE TABLE

CREATE TABLE agg_m_fact (
    id INT,
    dim_id INT,
    x INT
);
CREATE TABLE

INSERT INTO agg_m_dim VALUES
    (1, 'A', true),
    (2, 'B', false),
    (3, 'A', false),
    (4, 'C', true);
INSERT 0 4

INSERT INTO agg_m_fact VALUES
    (1, 1, 1),
    (2, 1, 2),
    (3, 2, 3),
    (4, 2, 4),
    (5, 3, 5),
    (6, 3, NULL),
    (7, 4, 7),
    (8, 4, 8);
INSERT 0 8

SELECT
    d.category,
    f.cnt_star,
    f.sum_x
FROM (
    SELECT
        dim_id,
        count(*) AS cnt_star,
        sum(x) AS sum_x
    FROM agg_m_fact
    GROUP BY dim_id
) AS f
JOIN agg_m_dim d ON f.dim_id = d.dim_id
ORDER BY d.category;
d.category	f.cnt_star	f.sum_x
A	2	3
A	2	5
B	2	7
C	2	15

SELECT
    category,
    sum_x
FROM (
    SELECT
        d.category AS category,
        f.sum_x AS sum_x
    FROM (
        SELECT
            dim_id,
            sum(x) AS sum_x
        FROM agg_m_fact
        GROUP BY dim_id
    ) AS f
    JOIN agg_m_dim d ON f.dim_id = d.dim_id
) AS agg_m_sub
WHERE sum_x >= 6
ORDER BY category;
category	sum_x
B	7
C	15

SELECT
    d.category,
    f.sum_x
FROM (
    SELECT
        dim_id,
        sum(x) AS sum_x
    FROM agg_m_fact
    GROUP BY dim_id
) AS f
JOIN agg_m_dim d ON f.dim_id = d.dim_id
ORDER BY f.sum_x DESC, d.category;
d.category	f.sum_x
C	15
B	7
A	5
A	3

EXPLAIN SELECT
    category,
    sum_x,
    row_number() OVER (ORDER BY sum_x DESC, category) AS rn
FROM (
    SELECT
        category,
        sum(x) AS sum_x
    FROM (
        VALUES ('A', 1),
               ('A', 2),
               ('B', 3),
               ('C', 4)
    ) AS agg_m_values(category, x)
    GROUP BY category
) AS agg_m_window
ORDER BY rn;
QUERY PLAN
ORDER_BY  (rows=2)
  Sort Key: #2 ASC NULLS LAST
  ->  PROJECTION  (rows=2)
    Output: category, sum_x, rn
    ->  PROJECTION  (rows=2)
      Output: category, sum_x
      ->  PROJECTION  (rows=2)
        Output: category, sum_x
        ->  AGGREGATE  (rows=2)
          Group Key: #0
          Aggregates: sum(#1)
          Output: aggr_0, aggr_1
          ->  PROJECTION  (rows=4)
            Output: category, x
            ->  VALUES  (rows=4)

DROP TABLE IF EXISTS agg_m_dim;
DROP TABLE
