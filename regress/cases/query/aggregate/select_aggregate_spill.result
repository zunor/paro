DROP TABLE IF EXISTS agg_phasee_spill;
DROP TABLE

CREATE TABLE agg_phasee_spill(k1 INT, k2 INT, v INT);
CREATE TABLE

INSERT INTO agg_phasee_spill
SELECT
    (i % 4096)::INT AS k1,
    ((i / 7) % 256)::INT AS k2,
    1::INT AS v
FROM generate_series(1, 200000) AS gs(i);
INSERT 0 200000

SET temp_directory = '/tmp/paro_regress_agg_phasee_spill';
SET

SET max_temp_directory_size = '256MB';
SET

SET force_external = true;
SET

SET use_new_agg_spill = true;
SET

SET threads = 1;
SET

-- @normalize explain_operator_timing,explain_summary_timing,explain_runtime_bytes
EXPLAIN ANALYZE
SELECT k1, k2, SUM(v) AS sum_v
FROM agg_phasee_spill
GROUP BY k1, k2;
QUERY PLAN
PROJECTION  (rows=200000) (actual time=753.637..973.948 rows=28672 loops=16)
  Output: ref_1, ref_2, sum
  ->  HASH_GROUP_BY  (rows=200000) (actual time=160.191..974.088 rows=228672 loops=66)
        Group Key: k1, k2
        Aggregates: SUM(v)
        Key Mode: INLINE_KEY_8B
        Partitioning: RADIX_PARTITIONS=4
        Spilled: true
        Peak Memory: 57.6 MB
        ->  PROJECTION (actual time=160.155..677.277 rows=200000 loops=49)
              Output: k1, k2, v
              ->  ROWSET_SCAN on public.agg_phasee_spill (actual time=0.270..679.947 rows=200000 loops=50)
                    Columns: k1, k2, v
Execution Time: 294.097 ms
Rows Returned: 28672

SELECT
    count(*) AS group_cnt,
    min(sum_v) AS min_sum,
    max(sum_v) AS max_sum
FROM (
    SELECT k1, k2, SUM(v) AS sum_v
    FROM agg_phasee_spill
    GROUP BY k1, k2
    HAVING SUM(v) >= 10
) AS agg_phasee_having;
group_cnt	min_sum	max_sum
0	NULL	NULL

SET max_temp_directory_size = '64MB';
