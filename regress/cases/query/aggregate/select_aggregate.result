    GROUPING(grp) AS g_grp,
    GROUPING(flag) AS g_flag,
    grp,
    flag,
    count(*) AS cnt
FROM agg_phase0
GROUP BY ROLLUP (grp, flag)
ORDER BY g_grp, g_flag, grp, flag;
