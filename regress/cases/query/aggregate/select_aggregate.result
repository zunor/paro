SELECT
    g_tiny,
    sum(x) AS sum_x
FROM agg_phase3
GROUP BY g_tiny
ORDER BY g_tiny;
g_tiny	sum_x
1	60
2	150
NULL	150

EXPLAIN SELECT
    g_tiny,
    sum(x) AS sum_x
FROM (
    VALUES (1::TINYINT, 1::TINYINT, 10, true),
           (1::TINYINT, 1::TINYINT, 20, false),
           (1::TINYINT, 2::TINYINT, 30, true),
           (2::TINYINT, 1::TINYINT, 40, false),
           (2::TINYINT, 2::TINYINT, 50, true),
           (2::TINYINT, 2::TINYINT, 60, false),
           (NULL::TINYINT, 1::TINYINT, 70, true),
           (NULL::TINYINT, NULL::TINYINT, 80, false)
) AS agg_phase3_values(g_tiny, h_tiny, x, flag)
GROUP BY g_tiny;
QUERY PLAN
PROJECTION  (rows=3)
  Output: g_tiny, sum_x
  ->  AGGREGATE  (rows=3)
    Group Key: #0
    Aggregates: sum(#1)
    Output: aggr_0, aggr_1
    ->  PROJECTION  (rows=8)
      Output: g_tiny, x
      ->  VALUES  (rows=8)

SELECT
    g_tiny,
    h_tiny,
    count(*) AS cnt,
    sum(x) FILTER (WHERE flag) AS sum_flag_true
FROM agg_phase3
GROUP BY g_tiny, h_tiny
ORDER BY g_tiny, h_tiny;
g_tiny	h_tiny	cnt	sum_flag_true
