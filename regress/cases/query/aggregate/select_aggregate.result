SELECT
    grp,
    sum(DISTINCT x) FILTER (WHERE flag) AS sum_distinct_x_flag,
    count(DISTINCT y) FILTER (WHERE NOT flag) AS count_distinct_y_not_flag
FROM agg_phase0
GROUP BY grp
ORDER BY grp;
grp	sum_distinct_x_flag	count_distinct_y_not_flag
