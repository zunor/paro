CREATE TABLE agg_phase0 (
    grp INT,
    x INT,
    y INT,
    flag BOOLEAN,
    label VARCHAR
);
CREATE TABLE

INSERT INTO agg_phase0 VALUES
    (1, 1, 1, true, 'a'),
    (1, 2, 2, false, 'b'),
    (1, 2, 3, true, 'c'),
    (2, 3, 1, true, 'd'),
    (2, 4, 4, false, 'e'),
    (2, NULL, 5, true, 'f');
INSERT 0 6

SELECT count(*) FROM agg_phase0;
COUNT(*)
6

SELECT sum(x) FROM agg_phase0;
sum(x)
12

SELECT count(*) + sum(x) FROM agg_phase0;
COUNT(*) + sum(x)
18

SELECT count(DISTINCT x) FROM agg_phase0;
count(DISTINCT x)
4

SELECT sum(x) FILTER (WHERE flag) FROM agg_phase0;
sum(x) FILTER (WHERE flag)
6

SELECT grp + 10 AS g, sum(x * 2) FILTER (WHERE y >= 2) AS filtered_sum
FROM agg_phase0
GROUP BY grp + 10
ORDER BY g;
g	filtered_sum
11	8
12	8

EXPLAIN SELECT grp + 10 AS g, sum(x * 2) FILTER (WHERE y >= 2) AS filtered_sum
FROM (
    VALUES (1, 1, 1),
           (1, 2, 2),
           (1, 2, 3),
           (2, 3, 1),
           (2, 4, 4),
           (2, NULL, 5)
) AS agg_values(grp, x, y)
GROUP BY grp + 10;
QUERY PLAN
PROJECTION  (rows=3)
  Output: g, filtered_sum
  ->  AGGREGATE  (rows=3)
    Group Key: +(#0, 10)
    Aggregates: sum(*(#1, 2)) FILTER (WHERE #2 >= 2)
    Output: aggr_0, aggr_1
    ->  PROJECTION  (rows=6)
      Output: grp, x, y
      ->  VALUES  (rows=6)

EXPLAIN SELECT first(x) WITHIN GROUP (ORDER BY y DESC NULLS LAST)
FROM (
    VALUES (1, 1),
           (2, 2),
           (3, 3)
) AS ordered_values(x, y);
QUERY PLAN
PROJECTION  (rows=1)
  Output: first(x) WITHIN GROUP ( ORDER BY y DESC NULLS LAST )
  ->  AGGREGATE  (rows=1)
    Aggregates: first(#0) WITHIN GROUP (ORDER BY #1 DESC NULLS LAST)
    Output: aggr_0
    ->  PROJECTION  (rows=3)
      Output: x, y
      ->  VALUES  (rows=3)

SELECT
    grp,
    sum(x) AS sum_all,
    count(x) AS cnt_x,
    count(*) AS cnt_star,
    count(x) FILTER (WHERE flag) AS count_true
FROM agg_phase0
GROUP BY grp
ORDER BY grp;
grp	sum_all	cnt_x	cnt_star	count_true
1	5	3	3	2
2	7	2	3	1

SELECT
    grp,
    min(x) AS min_x,
    max(x) AS max_x,
    sum(x) FILTER (WHERE y >= 3) AS sum_y_ge_3
FROM agg_phase0
GROUP BY grp
ORDER BY grp;
grp	min_x	max_x	sum_y_ge_3
1	1	2	2
2	3	4	4

SELECT
    grp,
    sum(x) AS sum_all,
    sum(DISTINCT x) AS sum_distinct_x,
    count(DISTINCT y) AS count_distinct_y
FROM agg_phase0
GROUP BY grp
ORDER BY grp;
grp	sum_all	sum_distinct_x	count_distinct_y
1	5	3	3
2	7	7	3

SELECT
    count(DISTINCT x) AS cd_x,
    sum(DISTINCT x) AS sd_x,
    sum(x) FILTER (WHERE y >= 3) AS sum_y_ge_3,
    count(x) FILTER (WHERE NOT flag) AS cnt_not_flag
FROM agg_phase0;
cd_x	sd_x	sum_y_ge_3	cnt_not_flag
4	10	6	2

EXPLAIN SELECT grp,
       sum(x) AS sum_all,
       sum(DISTINCT x) AS sum_distinct_x,
       count(DISTINCT y) AS count_distinct_y
FROM (
    VALUES (1, 1, 1),
           (1, 2, 2),
           (1, 2, 3),
           (2, 3, 1),
           (2, 4, 4),
           (2, NULL, 5)
) AS agg_values_distinct(grp, x, y)
GROUP BY grp;
QUERY PLAN
PROJECTION  (rows=3)
  Output: grp, sum_all, sum_distinct_x, count_distinct_y
  ->  AGGREGATE  (rows=3)
    Group Key: #0
    Aggregates: sum(#1), sum(DISTINCT #1), count(DISTINCT #2)
    Output: aggr_0, aggr_1, aggr_2, aggr_3
    ->  PROJECTION  (rows=6)
      Output: grp, x, y
      ->  VALUES  (rows=6)

EXPLAIN SELECT grp + 10 AS g,
       sum(x) AS sum_x,
       count(x) FILTER (WHERE y >= 2) AS count_filtered
FROM (
    VALUES (1, 1, 1),
           (1, 2, 2),
           (1, 2, 3),
           (2, 3, 1),
           (2, 4, 4),
           (2, NULL, 5)
) AS agg_values2(grp, x, y)
GROUP BY grp + 10;
QUERY PLAN
PROJECTION  (rows=3)
  Output: g, sum_x, count_filtered
  ->  AGGREGATE  (rows=3)
    Group Key: +(#0, 10)
    Aggregates: sum(#1), count(#1) FILTER (WHERE #2 >= 2)
    Output: aggr_0, aggr_1, aggr_2
    ->  PROJECTION  (rows=6)
      Output: grp, x, y
      ->  VALUES  (rows=6)

SELECT sum(x) FILTER (WHERE x > 2) AS sum_x_gt_2
FROM agg_phase0;
sum_x_gt_2
7

SELECT
    sum(x) FILTER (WHERE flag) AS sum_flag_true,
    sum(x) FILTER (WHERE NOT flag) AS sum_flag_false,
    sum(y) FILTER (WHERE x IS NULL) AS sum_y_x_null,
    count(x) FILTER (WHERE x >= 2) AS cnt_x_ge_2
FROM agg_phase0;
sum_flag_true	sum_flag_false	sum_y_x_null	cnt_x_ge_2
6	6	5	4

SELECT
    grp,
    sum(x) FILTER (WHERE y >= 2) AS sum_y_ge_2,
    sum(x) FILTER (WHERE y >= 4) AS sum_y_ge_4,
    sum(y) FILTER (WHERE x IS NULL) AS sum_y_x_null,
    count(x) FILTER (WHERE x >= 2) AS cnt_x_ge_2
FROM agg_phase0
GROUP BY grp
ORDER BY grp;
grp	sum_y_ge_2	sum_y_ge_4	sum_y_x_null	cnt_x_ge_2
1	4	NULL	NULL	2
2	4	4	5	2

SELECT
    grp,
    sum(x) FILTER (WHERE flag) AS sum_flag_true,
    sum(DISTINCT x) FILTER (WHERE y >= 2) AS sum_distinct_y_ge_2,
    count(DISTINCT y) FILTER (WHERE x >= 2) AS count_distinct_y_x_ge_2
FROM agg_phase0
GROUP BY grp
ORDER BY grp;
grp	sum_flag_true	sum_distinct_y_ge_2	count_distinct_y_x_ge_2
1	3	2	2
2	3	4	2

EXPLAIN SELECT grp,
       sum(x) FILTER (WHERE y >= 2) AS sum_y_ge_2,
       sum(x) FILTER (WHERE y >= 4) AS sum_y_ge_4,
       count(x) FILTER (WHERE x >= 2) AS cnt_x_ge_2
FROM (
    VALUES (1, 1, 1),
           (1, 2, 2),
           (1, 2, 3),
           (2, 3, 1),
           (2, 4, 4),
           (2, NULL, 5)
) AS agg_values_filter(grp, x, y)
GROUP BY grp;
QUERY PLAN
PROJECTION  (rows=3)
  Output: grp, sum_y_ge_2, sum_y_ge_4, cnt_x_ge_2
  ->  AGGREGATE  (rows=3)
    Group Key: #0
    Aggregates: sum(#1) FILTER (WHERE #2 >= 2), sum(#1) FILTER (WHERE #2 >= 4), count(#1) FILTER (WHERE #1 >= 2)
    Output: aggr_0, aggr_1, aggr_2, aggr_3
    ->  PROJECTION  (rows=6)
      Output: grp, x, y
      ->  VALUES  (rows=6)

SELECT
    first(x) WITHIN GROUP (ORDER BY y DESC NULLS LAST) AS first_desc,
    last(x) WITHIN GROUP (ORDER BY y DESC NULLS LAST) AS last_desc
FROM agg_phase0;
first_desc	last_desc
4	3

SELECT first(x) WITHIN GROUP (ORDER BY y DESC NULLS LAST) FILTER (WHERE y < 4) AS first_desc_y_lt_4
FROM agg_phase0;
first_desc_y_lt_4
2

SELECT
    grp,
    first(x) WITHIN GROUP (ORDER BY y DESC NULLS LAST) AS first_desc,
    last(x) WITHIN GROUP (ORDER BY y DESC NULLS LAST) AS last_desc,
    sum(x) AS sum_all
FROM agg_phase0
GROUP BY grp
ORDER BY grp;
grp	first_desc	last_desc	sum_all
1	2	1	5
2	4	3	7

SELECT
    first(v) WITHIN GROUP (ORDER BY k DESC NULLS FIRST) AS first_nulls_first,
    first(v) WITHIN GROUP (ORDER BY k DESC NULLS LAST) AS first_nulls_last
FROM (
    VALUES (10, NULL),
           (20, 1),
           (30, 2)
) AS ordered_nulls(v, k);
first_nulls_first	first_nulls_last
10	30

EXPLAIN SELECT grp,
       first(x) WITHIN GROUP (ORDER BY y DESC NULLS LAST) AS first_desc,
       last(x) WITHIN GROUP (ORDER BY y DESC NULLS LAST) AS last_desc
FROM (
    VALUES (1, 1, 1),
           (1, 2, 2),
           (1, 2, 3),
           (2, 3, 1),
           (2, 4, 4),
           (2, NULL, 5)
) AS agg_values_ordered(grp, x, y)
GROUP BY grp;
QUERY PLAN
PROJECTION  (rows=3)
  Output: grp, first_desc, last_desc
  ->  AGGREGATE  (rows=3)
    Group Key: #0
    Aggregates: first(#1) WITHIN GROUP (ORDER BY #2 DESC NULLS LAST), last(#1) WITHIN GROUP (ORDER BY #2 DESC NULLS LAST)
    Output: aggr_0, aggr_1, aggr_2
    ->  PROJECTION  (rows=6)
      Output: grp, x, y
      ->  VALUES  (rows=6)

SELECT
    GROUPING(grp) AS grp_g,
    grp,
    sum(x) AS sum_x
FROM agg_phase0
GROUP BY GROUPING SETS ((grp), ())
ORDER BY grp_g, grp;
