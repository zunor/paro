0	1	2	NULL	3
1	1	NULL	NULL	6

SELECT
    GROUPING(grp) AS g_grp,
    GROUPING(flag) AS g_flag,
    grp,
    flag,
    count(*) AS cnt
FROM agg_phase0
GROUP BY CUBE (grp, flag)
ORDER BY g_grp, g_flag, grp, flag;
g_grp	g_flag	grp	flag	cnt
