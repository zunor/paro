SELECT
    round(var_pop(x), 6) AS var_pop_x,
    round(var_samp(x), 6) AS var_samp_x,
    round(variance(x), 6) AS variance_x,
    round(stddev_pop(x), 6) AS stddev_pop_x,
    round(stddev_samp(x), 6) AS stddev_samp_x,
    round(stddev(x), 6) AS stddev_x
FROM agg_phase0;
var_pop_x	var_samp_x	variance_x	stddev_pop_x	stddev_samp_x	stddev_x
1.040000	1.300000	1.300000	1.019804	1.140175	1.140175

SELECT
    grp,
    round(var_pop(x), 6) AS var_pop_x,
    round(stddev_samp(x), 6) AS stddev_samp_x
FROM agg_phase0
GROUP BY grp
ORDER BY grp;
grp	var_pop_x	stddev_samp_x
1	0.222222	0.577350
2	0.250000	0.707107

SELECT
    sum(DISTINCT x) FILTER (WHERE grp = 1) AS sum_distinct_grp1,
    count(DISTINCT y) FILTER (WHERE flag) AS count_distinct_y_flag
FROM agg_phase0;
sum_distinct_grp1	count_distinct_y_flag
