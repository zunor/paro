0	1	1	NULL	3
0	1	2	NULL	3
1	0	NULL	false	2
1	0	NULL	true	4
1	1	NULL	NULL	6

EXPLAIN SELECT GROUPING(grp) AS grp_g,
       grp,
       sum(x) AS sum_x
FROM (
    VALUES (1, 1),
           (1, 2),
           (1, 2),
           (2, 3),
           (2, 4),
           (2, NULL)
) AS agg_values_grouping(grp, x)
GROUP BY GROUPING SETS ((grp), ());
QUERY PLAN
PROJECTION  (rows=6)
  Output: grp_g, grp, sum_x
  ->  AGGREGATE  (rows=6)
    Group Key: #0
    Aggregates: sum(#1)
    Grouping Sets: (0), ()
    Output: aggr_0, aggr_1, aggr_2
    ->  PROJECTION  (rows=6)
      Output: grp, x
      ->  VALUES  (rows=6)

