) AS agg_phase3_values(g_tiny, h_tiny, x, flag)
GROUP BY GROUPING SETS ((g_tiny), ());
QUERY PLAN
PROJECTION  (rows=6)
  Output: g_tiny, sum_x
  ->  AGGREGATE  (rows=6)
    Group Key: #0
    Aggregates: sum(#1)
    Grouping Sets: (0), ()
    Output: aggr_0, aggr_1
    ->  PROJECTION  (rows=8)
      Output: g_tiny, x
