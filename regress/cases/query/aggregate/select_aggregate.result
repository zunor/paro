SELECT
    (k_int + (tag * 3000000)) AS inline_key,
    count(*) AS cnt
FROM (
    VALUES (1, 0),
           (1, 1),
           (2, 0),
           (2, 1),
           (3, 0),
           (3, 1)
) AS agg_phase32_single(k_int, tag)
GROUP BY (k_int + (tag * 3000000))
ORDER BY inline_key;
inline_key	cnt
1	1
2	1
3	1
3000001	1
3000002	1
3000003	1

EXPLAIN SELECT
    (k_int + (tag * 3000000)) AS inline_key,
    count(*) AS cnt
FROM (
    VALUES (1, 0),
           (1, 1),
           (2, 0),
           (2, 1),
           (3, 0),
           (3, 1)
) AS agg_phase32_single(k_int, tag)
GROUP BY (k_int + (tag * 3000000));
QUERY PLAN
PROJECTION  (rows=3)
  Output: inline_key, cnt
  ->  AGGREGATE  (rows=3)
    Group Key: +(#0, *(#1, 3000000))
    Aggregates: count_star(*)
    Output: aggr_0, aggr_1
    ->  PROJECTION  (rows=6)
      Output: k_int, tag
      ->  VALUES  (rows=6)

EXPLAIN SELECT
    (k_int + (tag * 3000000)) AS k_inline_int,
    k_small,
    k_tiny,
    sum(v) AS sum_v
FROM (
    VALUES (1, 1::SMALLINT, 1::TINYINT, 0, 10),
           (1, 1::SMALLINT, 1::TINYINT, 1, 20),
           (2, 2::SMALLINT, 2::TINYINT, 0, 30),
           (2, 2::SMALLINT, 2::TINYINT, 1, 40)
) AS agg_phase32_multi(k_int, k_small, k_tiny, tag, v)
GROUP BY (k_int + (tag * 3000000)), k_small, k_tiny;
QUERY PLAN
PROJECTION  (rows=4)
  Output: k_inline_int, k_small, k_tiny, sum_v
  ->  AGGREGATE  (rows=4)
    Group Key: +(#0, *(#3, 3000000)), #1, #2
    Aggregates: sum(#4)
    Output: aggr_0, aggr_1, aggr_2, aggr_3
    ->  PROJECTION  (rows=4)
      Output: k_int, k_small, k_tiny, tag, v
      ->  VALUES  (rows=4)

EXPLAIN SELECT
    (k_big + (tag::BIGINT * 30000000000::BIGINT)) AS k_big_range,
    k_int,
    sum(v) AS sum_v
FROM (
    VALUES (1::BIGINT, 1, 0, 10),
           (1::BIGINT, 1, 1, 20),
           (2::BIGINT, 2, 0, 30),
           (2::BIGINT, 2, 1, 40)
) AS agg_phase32_wide(k_big, k_int, tag, v)
GROUP BY (k_big + (tag::BIGINT * 30000000000::BIGINT)), k_int;
QUERY PLAN
PROJECTION  (rows=4)
  Output: k_big_range, k_int, sum_v
  ->  AGGREGATE  (rows=4)
    Group Key: +(#0, *(CAST(#2 AS BIGINT), 30000000000)), #1
    Aggregates: sum(#3)
    Output: aggr_0, aggr_1, aggr_2
    ->  PROJECTION  (rows=4)
      Output: k_big, k_int, tag, v
      ->  VALUES  (rows=4)

EXPLAIN SELECT
    k_big,
    k_int,
    sum(v) AS sum_v
FROM (
    VALUES (1::BIGINT, 1, 10),
           (5000000000::BIGINT, 1, 20),
           (5000000001::BIGINT, 2, 30),
           (9000000000::BIGINT, 2, 40)
) AS agg_phase34(k_big, k_int, v)
GROUP BY k_big, k_int;
QUERY PLAN
PROJECTION  (rows=4)
  Output: k_big, k_int, sum_v
  ->  AGGREGATE  (rows=4)
    Group Key: #0, #1
    Aggregates: sum(#2)
    Output: aggr_0, aggr_1, aggr_2
    ->  PROJECTION  (rows=4)
      Output: k_big, k_int, v
      ->  VALUES  (rows=4)

EXPLAIN SELECT
    k_big,
    k_int,
    sum(v) AS sum_v
FROM (
    VALUES (1::BIGINT, 1, 10),
           (5000000000::BIGINT, 1, 20),
           (5000000001::BIGINT, 2, 30),
           (9000000000::BIGINT, 2, 40)
) AS agg_phase34(k_big, k_int, v)
GROUP BY GROUPING SETS ((k_big, k_int), ());
QUERY PLAN
PROJECTION  (rows=4)
  Output: k_big, k_int, sum_v
  ->  AGGREGATE  (rows=4)
    Group Key: #0, #1
    Aggregates: sum(#2)
    Grouping Sets: (0, 1), ()
    Output: aggr_0, aggr_1, aggr_2
    ->  PROJECTION  (rows=4)
      Output: k_big, k_int, v
      ->  VALUES  (rows=4)

SET threads = 1;
SET

SET use_new_agg_spill = true;
SET

DROP TABLE IF EXISTS agg_phase35_spill;
DROP TABLE

CREATE TABLE agg_phase35_spill(k_unique BIGINT, k_repeat BIGINT, tag VARCHAR, v BIGINT);
CREATE TABLE

INSERT INTO agg_phase35_spill
SELECT
    (rep::BIGINT * 1000000::BIGINT) + k::BIGINT AS k_unique,
    k::BIGINT AS k_repeat,
    CASE WHEN rep % 2 = 0 THEN 'even' ELSE 'odd' END AS tag,
    1::BIGINT AS v
FROM generate_series(1, 80) AS rep_series(rep)
CROSS JOIN generate_series(0, 3999) AS key_series(k);
INSERT 0 320000

SELECT count(*) AS g_cnt
FROM (
    SELECT k_unique, tag, sum(v) AS s
    FROM agg_phase35_spill
    GROUP BY k_unique, tag
) AS agg_phase35_unique;
g_cnt
320000

SELECT
    min(cnt) AS min_cnt,
    max(cnt) AS max_cnt,
    count(*) AS group_cnt
FROM (
    SELECT k_repeat, tag, count(*) AS cnt
    FROM agg_phase35_spill
    GROUP BY k_repeat, tag
) AS agg_phase35_overlap;
min_cnt	max_cnt	group_cnt
40	40	8000

SELECT
    count(*) AS hot_group_cnt,
    min(cnt) AS min_cnt,
    max(cnt) AS max_cnt
FROM (
    SELECT k_repeat, count(*) AS cnt
    FROM agg_phase35_spill
    GROUP BY k_repeat
    HAVING count(*) > 70
) AS agg_phase35_having;
hot_group_cnt	min_cnt	max_cnt
4000	80	80

DROP TABLE IF EXISTS agg_phase35_spill;
DROP TABLE

RESET use_new_agg_spill;
RESET

SET threads = DEFAULT;
