CREATE TABLE agg_h_t (
    grp INT,
    x INT,
    flag BOOLEAN
);
CREATE TABLE

INSERT INTO agg_h_t VALUES
    (1, 1, true),
    (1, 2, false),
    (1, 3, true),
    (2, 10, true),
    (2, NULL, false),
    (3, 1, false);
INSERT 0 6

SELECT
    grp,
    count(*) AS cnt
FROM agg_h_t
GROUP BY grp
HAVING count(*) >= 2
ORDER BY grp;
grp	cnt
1	3
2	2

SELECT
    grp,
    sum(x) AS sum_x
FROM agg_h_t
GROUP BY grp
HAVING sum(x) > 3
ORDER BY grp;
grp	sum_x
1	6
2	10

SELECT
    grp,
    sum(x) AS sum_x,
    count(x) AS cnt_x
FROM agg_h_t
GROUP BY grp
HAVING sum(x) >= 3 AND count(x) >= 2
ORDER BY grp;
grp	sum_x	cnt_x
1	6	3

SELECT
    sum(x) AS total_sum
FROM agg_h_t
HAVING sum(x) > 0;
total_sum
17

EXPLAIN SELECT
    grp,
    sum(x) AS sum_x
FROM (
    VALUES (1, 1),
           (1, 2),
           (2, 3),
           (2, NULL),
           (3, 1)
) AS agg_h_values(grp, x)
GROUP BY grp
HAVING sum(x) >= 3
ORDER BY grp;
QUERY PLAN
ORDER_BY  (rows=1)
  Sort Key: #0 ASC NULLS LAST
  ->  PROJECTION  (rows=1)
    Output: grp, sum_x
    ->  FILTER  (rows=1)
      Filter: #1 >= 3
      ->  AGGREGATE  (rows=3)
        Group Key: #0
        Aggregates: sum(#1)
        Output: aggr_0, aggr_1
        ->  PROJECTION  (rows=5)
          Output: grp, x
          ->  VALUES  (rows=5)
