CREATE TABLE agg_o_t (
    grp INT,
    x INT,
    y INT,
    label VARCHAR
);
CREATE TABLE

INSERT INTO agg_o_t VALUES
    (1, 1, 1, 'a'),
    (1, 2, 2, 'b'),
    (1, 2, 3, 'c'),
    (2, 3, 1, 'd'),
    (2, 4, 4, 'e'),
    (2, NULL, 5, 'f');
INSERT 0 6

SELECT
    first(x) WITHIN GROUP (ORDER BY y DESC NULLS LAST) AS first_desc,
    last(x) WITHIN GROUP (ORDER BY y DESC NULLS LAST) AS last_desc
FROM agg_o_t;
first_desc	last_desc
4	3

SELECT
    grp,
    first(x) WITHIN GROUP (ORDER BY y ASC NULLS LAST) AS first_asc,
    last(x) WITHIN GROUP (ORDER BY y ASC NULLS LAST) AS last_asc
FROM agg_o_t
GROUP BY grp
ORDER BY grp;
grp	first_asc	last_asc
1	1	2
2	3	4

SELECT
    grp,
    string_agg(label, '|') WITHIN GROUP (ORDER BY y DESC NULLS LAST) AS labels_desc
FROM agg_o_t
GROUP BY grp
ORDER BY grp;
grp	labels_desc
1	c|b|a
2	f|e|d

SELECT
    array_agg(x) WITHIN GROUP (ORDER BY y DESC NULLS LAST) FILTER (WHERE grp = 1) AS xs_grp1
FROM agg_o_t;
xs_grp1
[2.000000, 2.000000, 1.000000]

EXPLAIN SELECT
    first(x) WITHIN GROUP (ORDER BY y DESC NULLS LAST) AS first_desc,
    string_agg(label, '|') WITHIN GROUP (ORDER BY y DESC NULLS LAST) AS labels_desc
FROM (
    VALUES (1, 1, 'a'),
           (2, 2, 'b'),
           (2, 3, 'c'),
           (3, 1, 'd')
) AS agg_o_values(x, y, label);
QUERY PLAN
PROJECTION  (rows=1)
  Output: first, string_agg
  ->  UNGROUPED_AGGREGATE  (rows=1)
        Aggregates: FIRST(col0) WITHIN GROUP (ORDER BY col1 DESC NULLS LAST), STRING_AGG(col2, '|') WITHIN GROUP (ORDER BY col1 DESC NULLS LAST)
        ->  PROJECTION
              Output: col0, col1, col2, '|', col1
              ->  PROJECTION  (rows=4)
                    Output: col0, col1, col2
                    ->  EXPRESSION_SCAN  (rows=4)
