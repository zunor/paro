DROP TABLE IF EXISTS agg_defer_plan_dimension;
DROP TABLE

DROP TABLE IF EXISTS agg_defer_dimension;
DROP TABLE

CREATE TABLE agg_defer_dimension (
    key_a BIGINT,
    key_b BIGINT,
    payload VARCHAR,
    PRIMARY KEY (key_a, key_b)
);
CREATE TABLE

CREATE TABLE agg_defer_plan_dimension (
    key_a BIGINT PRIMARY KEY,
    payload VARCHAR
);
CREATE TABLE

CREATE TABLE agg_defer_fact (
    key_a BIGINT,
    key_b BIGINT,
    amount BIGINT,
    keep BOOLEAN
);
CREATE TABLE

INSERT INTO agg_defer_dimension VALUES
    (1, 1, 'same'),
    (2, 2, 'same'),
    (3, 3, NULL),
    (4, 4, 'other');
INSERT 0 4

INSERT INTO agg_defer_plan_dimension
SELECT key_a, payload FROM agg_defer_dimension;
INSERT 0 4

INSERT INTO agg_defer_fact
SELECT 1, 1, 10, true FROM generate_series(1, 2000) AS generated(i);
INSERT 0 2000

INSERT INTO agg_defer_fact
SELECT 2, 2, 20, false FROM generate_series(1, 2000) AS generated(i);
INSERT 0 2000

INSERT INTO agg_defer_fact
SELECT 3, 3, NULL, true FROM generate_series(1, 2000) AS generated(i);
INSERT 0 2000

INSERT INTO agg_defer_fact
SELECT 4, 4, 5, true FROM generate_series(1, 2000) AS generated(i);
INSERT 0 2000

INSERT INTO agg_defer_fact
SELECT NULL, NULL, 100, true FROM generate_series(1, 2000) AS generated(i);
INSERT 0 2000

INSERT INTO agg_defer_fact
SELECT 9, 9, 200, true FROM generate_series(1, 2000) AS generated(i);
INSERT 0 2000

EXPLAIN SELECT
    d.payload,
    count(*) AS row_count,
    sum(f.amount) AS total_amount,
    sum(f.amount) FILTER (WHERE f.keep) AS kept_amount
FROM agg_defer_fact AS f
JOIN agg_defer_plan_dimension AS d
  ON f.key_a = d.key_a
GROUP BY d.payload;
QUERY PLAN
PROJECTION  (rows=2)
  Output: d.payload, row_count, total_amount, kept_amount
  ->  AGGREGATE  (rows=2)
    Group Key: #3
    Aggregates: count_partial_merge(#0), sum_partial_merge(#1), sum_partial_merge(#2)
    Output: aggr_0, aggr_1, aggr_2, aggr_3
    ->  HASH_JOIN  (rows=4)
      Join Type: INNER
      Build Index: integer_build_time
      Join Condition: #0 = #0
      ->  AGGREGATE  (rows=5)
        Group Key: #0
        Aggregates: count_star(*), sum(#1), sum(#1) FILTER (WHERE #2)
        Output: aggr_0, aggr_1, aggr_2, aggr_3
        ->  HASH_JOIN  (rows=9600)
          Join Type: INNER
          Build Index: integer_build_time
          Join Condition: #0 = #0
          ->  ROWSET_SCAN on public.agg_defer_fact f
            Columns: key_a, amount, keep
            Pushed Predicate: col#0 <= 4 AND col#0 >= 1
            Late Materialize: auto
            Runtime Filter: #0 >= 1 AND #0 <= 4
          ->  ROWSET_SCAN on public.agg_defer_plan_dimension d  (rows=4)
            Columns: key_a
      ->  ROWSET_SCAN on public.agg_defer_plan_dimension d  (rows=4)
        Columns: key_a, payload

SELECT
    d.payload,
    count(*) AS row_count,
    sum(f.amount) AS total_amount,
    sum(f.amount) FILTER (WHERE f.keep) AS kept_amount
FROM agg_defer_fact AS f
JOIN agg_defer_dimension AS d
  ON f.key_a = d.key_a AND f.key_b = d.key_b
GROUP BY d.payload
ORDER BY d.payload NULLS LAST;
d.payload	row_count	total_amount	kept_amount
other	2000	10000	10000
same	4000	60000	20000
NULL	2000	NULL	NULL

SELECT
    d.payload,
    f.keep,
    count(*) AS row_count,
    sum(f.amount) AS total_amount,
    sum(f.amount) FILTER (WHERE f.keep) AS kept_amount
FROM agg_defer_fact AS f
JOIN agg_defer_dimension AS d
  ON f.key_a = d.key_a AND f.key_b = d.key_b
GROUP BY d.payload, f.keep
ORDER BY d.payload NULLS LAST, f.keep;
d.payload	f.keep	row_count	total_amount	kept_amount
other	true	2000	10000	10000
same	false	2000	40000	NULL
same	true	2000	20000	20000
NULL	true	2000	NULL	NULL

DROP TABLE IF EXISTS agg_defer_plan_dimension;
DROP TABLE

DROP TABLE IF EXISTS agg_defer_dimension;
DROP TABLE
