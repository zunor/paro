CREATE TABLE agg_f_t (
    grp INT,
    x INT,
    y INT,
    flag BOOLEAN
);
CREATE TABLE

INSERT INTO agg_f_t VALUES
    (1, 1, 1, true),
    (1, 2, 2, false),
    (1, 2, 3, true),
    (2, 3, 1, true),
    (2, 4, 4, false),
    (2, NULL, 5, true);
INSERT 0 6

SELECT
    sum(x) FILTER (WHERE flag) AS sum_true,
    sum(x) FILTER (WHERE NOT flag) AS sum_false,
    count(x) FILTER (WHERE x >= 2) AS cnt_x_ge2,
    sum(y) FILTER (WHERE x IS NULL) AS sum_y_x_null
FROM agg_f_t;
sum_true	sum_false	cnt_x_ge2	sum_y_x_null
6	6	4	5

SELECT
    grp,
    sum(x) FILTER (WHERE y >= 2) AS sum_y_ge2,
    sum(x) FILTER (WHERE flag) AS sum_true,
    count(DISTINCT y) FILTER (WHERE x >= 2) AS cd_y_x_ge2
FROM agg_f_t
GROUP BY grp
ORDER BY grp;
grp	sum_y_ge2	sum_true	cd_y_x_ge2
1	4	3	2
2	4	3	2

SELECT
    grp,
    sum(x) FILTER (WHERE x > 100) AS sum_none
FROM agg_f_t
GROUP BY grp
ORDER BY grp;
grp	sum_none
1	NULL
2	NULL

EXPLAIN SELECT
    grp,
    sum(x) FILTER (WHERE flag) AS sum_true,
    count(x) FILTER (WHERE y >= 2) AS cnt_y_ge2
FROM (
    VALUES (1, 1, 1, true),
           (1, 2, 2, false),
           (1, 2, 3, true),
           (2, 3, 1, true),
           (2, 4, 4, false),
           (2, NULL, 5, true)
) AS agg_f_values(grp, x, y, flag)
GROUP BY grp
ORDER BY grp;
QUERY PLAN
PROJECTION  (rows=3)
  Output: grp, sum_true, cnt_y_ge2
  ->  ORDER_BY  (rows=3)
        Sort Key: ref_1 ASC NULLS LAST
        ->  PROJECTION  (rows=3)
              Output: ref_1, sum, count, ref_1
              ->  HASH_GROUP_BY  (rows=3)
                    Group Key: col0
                    Aggregates: SUM(col1) FILTER (WHERE col3), COUNT(col1) FILTER (WHERE (col2 >= 2))
                    Key Mode: INLINE_KEY_4B
                    ->  PROJECTION
                          Output: col0, col1, col3, col1, (col2 >= 2)
                          ->  PROJECTION  (rows=6)
                                Output: col0, col1, col2, col3
                                ->  EXPRESSION_SCAN  (rows=6)
