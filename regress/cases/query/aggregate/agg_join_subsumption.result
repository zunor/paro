DROP TABLE IF EXISTS agg_sub_preserved;
DROP TABLE

CREATE TABLE agg_sub_detail (
    order_key BIGINT,
    quantity DECIMAL(15, 2)
);
CREATE TABLE

CREATE TABLE agg_sub_preserved (
    order_key BIGINT,
    label VARCHAR
);
CREATE TABLE

INSERT INTO agg_sub_detail VALUES
    (1, 40.00),
    (1, 70.00),
    (2, 60.00),
    (2, 30.00),
    (3, NULL),
    (3, NULL),
    (4, 150.00),
    (NULL, 200.00);
INSERT 0 8

INSERT INTO agg_sub_preserved VALUES
    (1, 'duplicate'),
    (1, 'duplicate'),
    (2, 'below-threshold'),
    (3, 'all-null'),
    (4, 'single-row'),
    (NULL, 'null-key');
INSERT 0 6

EXPLAIN SELECT
    p.order_key,
    p.label,
    sum(d.quantity) AS total_quantity
FROM agg_sub_preserved AS p
JOIN agg_sub_detail AS d
  ON d.order_key = p.order_key
WHERE p.order_key IN (
    SELECT order_key
    FROM agg_sub_detail
    GROUP BY order_key
    HAVING sum(quantity) > 100.00
)
GROUP BY p.order_key, p.label
ORDER BY p.order_key;
QUERY PLAN
ORDER_BY  (rows=4)
  Sort Key: p.order_key ASC NULLS LAST
  ->  PROJECTION  (rows=4)
    Output: p.order_key, p.label, total_quantity
    ->  AGGREGATE  (rows=4)
      Group Key: p.order_key, p.label
      Aggregates: sum(partial_aggregate)
      Output: p.order_key, p.label, sum(partial_aggregate)
      ->  HASH_JOIN  (rows=4)
        Join Type: INNER
        Join Condition: p.order_key = order_key
        ->  ROWSET_SCAN on public.agg_sub_preserved p  (rows=6)
          Columns: order_key, label
        ->  PROJECTION  (rows=3)
          Output: order_key, partial_aggregate
          ->  AGGREGATE  (rows=3)
            Group Key: order_key
            Aggregates: sum(quantity)
            Output: order_key, sum(quantity)
            ->  ROWSET_SCAN on public.agg_sub_detail  (rows=8)
              Columns: order_key, quantity

SELECT
    p.order_key,
    p.label,
    sum(d.quantity) AS total_quantity
FROM agg_sub_preserved AS p
JOIN agg_sub_detail AS d
  ON d.order_key = p.order_key
WHERE p.order_key IN (
    SELECT order_key
    FROM agg_sub_detail
    GROUP BY order_key
    HAVING sum(quantity) > 100.00
)
GROUP BY p.order_key, p.label
ORDER BY p.order_key;
