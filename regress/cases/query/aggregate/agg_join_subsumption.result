DROP TABLE IF EXISTS agg_sub_preserved;
DROP TABLE

CREATE TABLE agg_sub_detail (
    order_key BIGINT,
    quantity DECIMAL(15, 2)
);
CREATE TABLE

CREATE TABLE agg_sub_preserved (
    order_key BIGINT,
    label VARCHAR
);
CREATE TABLE

INSERT INTO agg_sub_detail VALUES
    (1, 40.00),
    (1, 70.00),
    (2, 60.00),
    (2, 30.00),
    (3, NULL),
    (3, NULL),
