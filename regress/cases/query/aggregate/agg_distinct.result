CREATE TABLE agg_d_t (
    grp INT,
    x INT,
    y INT
);
CREATE TABLE

INSERT INTO agg_d_t VALUES
    (1, 1, 10),
    (1, 1, 10),
    (1, 2, 20),
    (1, NULL, 30),
    (2, 2, 20),
    (2, 3, 20),
    (2, 3, NULL),
    (2, NULL, NULL);
INSERT 0 8

SELECT
    count(DISTINCT x) AS cd_x,
    sum(DISTINCT x) AS sd_x,
    count(DISTINCT y) AS cd_y
FROM agg_d_t;
cd_x	sd_x	cd_y
3	6	3

SELECT
    grp,
    count(DISTINCT x) AS cd_x,
    sum(DISTINCT x) AS sd_x,
    count(DISTINCT y) AS cd_y
FROM agg_d_t
GROUP BY grp
ORDER BY grp;
grp	cd_x	sd_x	cd_y
1	2	3	3
2	2	5	1

SELECT
    grp,
    sum(x) AS sum_all,
    sum(DISTINCT x) AS sum_distinct,
    count(*) AS cnt_star,
    count(DISTINCT x) AS cnt_distinct
FROM agg_d_t
GROUP BY grp
ORDER BY grp;
grp	sum_all	sum_distinct	cnt_star	cnt_distinct
1	4	3	4	2
2	8	5	4	2

EXPLAIN SELECT
    grp,
    count(DISTINCT x) AS cd_x,
    sum(DISTINCT y) AS sd_y
FROM (
    VALUES (1, 1, 10),
           (1, 1, 10),
           (1, 2, 20),
           (2, 2, 20),
           (2, 3, 20),
           (2, 3, NULL)
) AS agg_d_values(grp, x, y)
GROUP BY grp
ORDER BY grp;
QUERY PLAN
ORDER_BY  (rows=3)
  Sort Key: grp ASC NULLS LAST
  ->  PROJECTION  (rows=3)
    Output: grp, cd_x, sd_y
    ->  AGGREGATE  (rows=3)
      Group Key: agg_d_values.grp
      Aggregates: count(DISTINCT agg_d_values.x), sum(DISTINCT agg_d_values.y)
      ->  PROJECTION  (rows=6)
        Output: grp, x, y
        ->  VALUES  (rows=6)

DROP TABLE IF EXISTS agg_d_parallel;
DROP TABLE

CREATE TABLE agg_d_parallel (
    grp INT,
    x INT,
    y INT,
    keep BOOLEAN
);
CREATE TABLE

INSERT INTO agg_d_parallel
SELECT
    i % 8,
    i % 97,
    CASE WHEN i % 11 = 0 THEN NULL ELSE i % 53 END,
    i % 3 = 0
FROM generate_series(1, 50000) AS generated(i);
INSERT 0 50000

SET threads = 4;
SET

SELECT
    count(DISTINCT x) AS cd_x,
    sum(DISTINCT x) AS sd_x,
    count(DISTINCT y) AS cd_y,
    sum(DISTINCT y) AS sd_y,
    count(DISTINCT x) FILTER (WHERE keep) AS cd_x_filtered
FROM agg_d_parallel;
cd_x	sd_x	cd_y	sd_y	cd_x_filtered
97	4656	53	1378	97

SELECT
    grp,
    count(DISTINCT x) AS cd_x,
    sum(DISTINCT x) AS sd_x,
    count(DISTINCT y) AS cd_y,
    sum(DISTINCT y) AS sd_y,
    count(DISTINCT x) FILTER (WHERE keep) AS cd_x_filtered
FROM agg_d_parallel
GROUP BY grp
ORDER BY grp;
grp	cd_x	sd_x	cd_y	sd_y	cd_x_filtered
0	97	4656	53	1378	97
1	97	4656	53	1378	97
2	97	4656	53	1378	97
3	97	4656	53	1378	97
4	97	4656	53	1378	97
5	97	4656	53	1378	97
6	97	4656	53	1378	97
7	97	4656	53	1378	97

SET threads = DEFAULT;
SET

DROP TABLE agg_d_parallel;
DROP TABLE
