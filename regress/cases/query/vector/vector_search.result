SELECT id FROM items WHERE id > 10 ORDER BY emb <-> '[1.0, 1.0, 1.0]' LIMIT 2;
id

SELECT id, emb <-> '[1.0, 1.0, 1.0]' as dist FROM items ORDER BY id;
id	dist
1	0.000000
2	1.732051
3	1.000000
4	1.732051

EXPLAIN SELECT id FROM items ORDER BY emb <-> '[1.0, 1.0, 1.0]' LIMIT 2;
QUERY PLAN
PROJECTION  (rows=2)
  Output: id
  ->  TOP_N  (rows=2)
    Sort Key: l2_distance(public.items.emb, [1, 1, 1]) ASC NULLS LAST
    Limit: 2
    ->  PROJECTION  (rows=4)
      Output: id, l2_distance(public.items.emb, [1, 1, 1])
      ->  ROWSET_SCAN on public.items  (rows=4)
        Columns: id, emb

SELECT id FROM items ORDER BY emb <-> '[1.0, 1.0, 1.0]' LIMIT 2;
id
1
3

CREATE TABLE indexed_items (id INT, bucket SMALLINT, emb VECTOR(3));
CREATE TABLE

CREATE INDEX idx_indexed_items_bucket ON indexed_items (bucket);
CREATE INDEX

CREATE VECTOR INDEX idx_indexed_items_emb ON indexed_items (emb)
    distance = l2
    m = 8
    ef_construct = 32
    ef_search = 24
    build_seed = 7
    plain_scan_threshold = 0
    filtered_plain_scan_threshold = 256
    inline_max_vector_count = 4096
    inline_max_graph_memory_bytes = 1048576
    inline_max_dimension = 3;
CREATE INDEX

INSERT INTO indexed_items
SELECT i, i % 10, '[1.0,1.0,1.0]'::VECTOR(3)
FROM generate_series(1, 2048) AS generated(i);
INSERT 0 2048

SELECT index_name, index_type FROM paro_indexes()
WHERE index_name = 'idx_indexed_items_emb';
index_name	index_type
idx_indexed_items_emb	HNSW

-- @normalize explain_search_ids
EXPLAIN SELECT id FROM indexed_items
ORDER BY emb <-> '[1.0, 1.0, 1.0]' LIMIT 2;
QUERY PLAN
PROJECTION  (rows=2)
  Output: id
  ->  VECTOR_SEARCH on public.indexed_items  (rows=2)
    Search Definition: <search-definition-id>
    Search Generation: <search-generation-id>
    Search Root: <search-root-id>
    Search Capability: Queryable
    Search Candidate: dense vector
    Column: emb
    Limit: 2
    Search Ef: default

-- @normalize explain_search_ids
EXPLAIN SELECT id FROM indexed_items
WHERE bucket = 3
ORDER BY emb <-> '[1.0, 1.0, 1.0]' LIMIT 2;
QUERY PLAN
PROJECTION  (rows=2)
  Output: id
  ->  VECTOR_SEARCH on public.indexed_items  (rows=2)
    Search Definition: <search-definition-id>
    Search Generation: <search-generation-id>
    Search Root: <search-root-id>
    Search Capability: Queryable
    Search Candidate: dense vector
    Column: emb
    Limit: 2
    Search Ef: default
    Pushed Predicate: bucket = 3
    Filter Pushdown: exact segment bitmap; no residual filter
    Filter Rows (estimated): 205
    Filtered Strategy: exact bitmap distance scan (estimated 205/2048 rows; exact threshold 256)

-- @normalize explain_search_ids
EXPLAIN SELECT id FROM indexed_items
ORDER BY emb <=> '[1.0, 0.0, 0.0]' LIMIT 2;
QUERY PLAN
PROJECTION  (rows=2)
  Output: id
  ->  TOP_N  (rows=2)
    Sort Key: cosine_distance(public.indexed_items.emb, [1, 0, 0]) ASC NULLS LAST
    Limit: 2
    ->  PROJECTION  (rows=2048)
      Output: id, cosine_distance(public.indexed_items.emb, [1, 0, 0])
      ->  ROWSET_SCAN on public.indexed_items  (rows=2048)
        Columns: id, emb

SELECT id FROM indexed_items
ORDER BY emb <=> '[1.0, 0.0, 0.0]', id LIMIT 2;
id
1
2

PREPARE vector_topk(VECTOR(3)) AS
    SELECT id FROM indexed_items ORDER BY emb <-> $1 LIMIT 2;
PREPARE

EXECUTE vector_topk('[1.0, 1.0, 1.0]');
id
1976
1742

EXECUTE vector_topk('[2.0, 2.0, 2.0]');
id
1976
1742

DEALLOCATE vector_topk;
DEALLOCATE

PREPARE filtered_vector_topk(INT, VECTOR(3)) AS
    SELECT bucket FROM indexed_items
    WHERE bucket = $1
    ORDER BY emb <-> $2 LIMIT 2;
PREPARE

EXECUTE filtered_vector_topk(3, '[1.0, 1.0, 1.0]');
bucket
3
3

EXECUTE filtered_vector_topk(7, '[1.0, 1.0, 1.0]');
bucket
7
7

EXECUTE filtered_vector_topk(100000, '[1.0, 1.0, 1.0]');
bucket

-- @normalize explain_search_ids
EXPLAIN EXECUTE filtered_vector_topk(3, '[1.0, 1.0, 1.0]');
QUERY PLAN
PROJECTION  (rows=2)
  Output: bucket
  ->  VECTOR_SEARCH on public.indexed_items  (rows=2)
    Search Definition: <search-definition-id>
    Search Generation: <search-generation-id>
    Search Root: <search-root-id>
    Search Capability: Queryable
    Search Candidate: dense vector
    Column: emb
    Limit: 2
    Search Ef: default
    Pushed Predicate: bucket = 3
    Filter Pushdown: exact segment bitmap; no residual filter
    Filter Rows (estimated): 205
    Filtered Strategy: exact bitmap distance scan (estimated 205/2048 rows; exact threshold 256)

DEALLOCATE filtered_vector_topk;
DEALLOCATE

