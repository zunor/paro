CREATE TABLE items (id INT PRIMARY KEY, emb VECTOR(3));
CREATE TABLE

INSERT INTO items VALUES (1, '[1.0, 1.0, 1.0]');
INSERT 0 1

INSERT INTO items VALUES (2, '[2.0, 2.0, 2.0]');
INSERT 0 1

