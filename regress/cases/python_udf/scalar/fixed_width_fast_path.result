DROP FUNCTION IF EXISTS py_numpy_fast(INTEGER);
DROP FUNCTION

-- @normalize regress_paths
CREATE FUNCTION py_numpy_fast(a INTEGER) RETURNS INTEGER
LANGUAGE python
IMMUTABLE
IMPORTS ('<repo>/regress/report/fixtures/python_udf/scalar/fixed_width_fast_path/python_udf/modules/fake_numpy/numpy.py')
AS $$
import numpy
return a.to_numpy() + 7
$$;
CREATE FUNCTION

SELECT py_numpy_fast(v)
FROM (VALUES (4), (9)) AS t(v)
ORDER BY 1;
py_numpy_fast(v)
11
16

DROP FUNCTION py_numpy_fast(INTEGER);
DROP FUNCTION
