DROP FUNCTION IF EXISTS py_imported(INTEGER);
DROP FUNCTION

CREATE FUNCTION py_imported(a INTEGER) RETURNS INTEGER
LANGUAGE python
IMMUTABLE
HANDLER 'main'
AS $$
def shift(value):
    return value + 10

def main(ctx, a):
    return shift(a)
$$;
CREATE FUNCTION

SELECT py_imported(v)
FROM (VALUES (1), (2), (3)) AS t(v)
ORDER BY 1;
py_imported(v)
11
12
13

DROP FUNCTION py_imported(INTEGER);
DROP FUNCTION
