DROP FUNCTION IF EXISTS py_explain(INTEGER);
DROP FUNCTION

CREATE FUNCTION py_explain(a INTEGER) RETURNS INTEGER
LANGUAGE python
IMMUTABLE
AS $$return [value + 3 for value in a.materialize_py()]$$;
CREATE FUNCTION

-- @normalize explain_routine_ids
EXPLAIN
SELECT py_explain(v)
FROM (VALUES (1), (2)) AS t(v)
ORDER BY 1;
