DROP FUNCTION IF EXISTS py_explain(INTEGER);
DROP FUNCTION

CREATE FUNCTION py_explain(a INTEGER) RETURNS INTEGER
LANGUAGE python
IMMUTABLE
AS $$return [value + 3 for value in a.materialize_py()]$$;
CREATE FUNCTION

-- @normalize explain_routine_ids
EXPLAIN
SELECT py_explain(v)
FROM (VALUES (1), (2)) AS t(v)
ORDER BY 1;
QUERY PLAN
ORDER_BY  (rows=2)
  Sort Key: #0 ASC NULLS LAST
  ->  PROJECTION  (rows=2)
    Output: py_explain(v)
    ->  EXTERNAL_PROJECT  (rows=2)
      ->  PROJECTION  (rows=2)
        Output: v
        ->  VALUES  (rows=2)

-- @normalize explain_operator_timing,explain_summary_timing,explain_runtime_bytes,explain_routine_ids,explain_external_runtime
EXPLAIN ANALYZE
SELECT py_explain(v)
FROM (VALUES (1), (2)) AS t(v)
ORDER BY 1;
QUERY PLAN
PIPELINE 0
  SOURCE #0 VALUES (actual time=<time-range> rows=2 loops=<loops>)
  TRANSFORM #1 PROJECTION (actual time=<time-range> rows=2 loops=<loops>)
  TRANSFORM #2 EXTERNAL_PROJECT (actual time=<time-range> rows=2 loops=<loops>)
  TRANSFORM #3 PROJECTION (actual time=<time-range> rows=2 loops=<loops>)
  SINK #4 SORT_BUILD (actual time=<time-range> rows=2 loops=<loops> peak_memory_bytes=<bytes>)
PIPELINE 1
  SOURCE #5 SORT_EMIT (actual time=<time-range> rows=2 loops=<loops>)
  SINK #6 CLIENT_RESULT (actual time=<time-range> rows=2 loops=<loops>)
PROFILE schema_version=1 query_id=<id> events=<events> parallelism=<threads> workers=<workers> worker_utilization=<ratio> ready_time_us=<us> wait_time_us=<us> wake_coalesce=<count> backpressure=<count> runtime_filter_installed=0 runtime_filter_no_wait=0
MEMORY_PROFILE grant_bytes=<bytes> revoked_bytes=<bytes> revocable_bytes=<bytes> spill_bytes=<bytes> spill_latency_us=<us> yield_latency_us=<us> repartition_depth=0
Execution Time: <time-ms>
Rows Returned: 2

DROP FUNCTION py_explain(INTEGER);
DROP FUNCTION
