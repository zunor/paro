DROP FUNCTION IF EXISTS py_missing_probe(INTEGER);
DROP FUNCTION

CREATE FUNCTION py_missing_probe(a INTEGER) RETURNS INTEGER
LANGUAGE python
AS $$return [value + 2 for value in a.materialize_py()]$$;
CREATE FUNCTION

SELECT py_missing_probe(1);
py_missing_probe(1)
3

SELECT 7 * 6;
7 * 6
42

