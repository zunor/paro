DROP FUNCTION IF EXISTS py_disabled_probe(INTEGER);
DROP FUNCTION

CREATE FUNCTION py_disabled_probe(a INTEGER) RETURNS INTEGER
LANGUAGE python
AS $$return [value + 1 for value in a.materialize_py()]$$;
CREATE FUNCTION

SELECT py_disabled_probe(1);
py_disabled_probe(1)
2

SELECT 41 + 1;
41 + 1
42

