DROP FUNCTION IF EXISTS py_scale(INTEGER);
DROP FUNCTION

CREATE FUNCTION py_scale(a INTEGER) RETURNS TABLE (value INTEGER)
LANGUAGE python
AS $$return [value * 10 for value in a.materialize_py()]$$;
CREATE FUNCTION

-- @normalize explain_routine_ids
EXPLAIN
SELECT t.x, s.value
FROM (VALUES (1), (2), (3)) AS t(x)
CROSS JOIN LATERAL py_scale(t.x) AS s
ORDER BY 1, 2;
QUERY PLAN
ORDER_BY  (rows=30)
  Sort Key: t.x ASC NULLS LAST, s.value ASC NULLS LAST
  ->  PROJECTION  (rows=30)
    Output: t.x, s.value
    ->  DELIM_JOIN  (rows=30)
      ->  PROJECTION  (rows=3)
        Output: x
        ->  VALUES  (rows=3)
      ->  HASH_JOIN
        Join Type: INNER
        Join Condition: t.x IS NOT DISTINCT FROM x
        ->  DELIM_SCAN
        ->  EXTERNAL_TABLE  (rows=100)
          ->  PROJECTION  (rows=1)
            Output: __external_arg_1, x
            ->  CROSS_PRODUCT  (rows=1)
              ->  DELIM_SCAN  (rows=1)
              ->  DUMMY_SCAN  (rows=1)

DROP FUNCTION py_scale(INTEGER);
DROP FUNCTION
