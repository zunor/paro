CREATE INDEX idx_ft_global_stats_docs ON ft_global_stats_docs USING GIN (to_tsvector('simple', content));
CREATE INDEX

SELECT id
FROM ft_global_stats_docs
WHERE fulltext_match(content, 'vector')
ORDER BY bm25(content, 'vector') DESC, id
LIMIT 2;
