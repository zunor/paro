CREATE TABLE ft_exec_mode_split (
    id INT,
    content VARCHAR
);
CREATE TABLE

INSERT INTO ft_exec_mode_split VALUES
    (1, 'vector database vector'),
    (2, 'vector database'),
    (3, 'database vector'),
    (4, 'vector'),
    (5, 'noise');
INSERT 0 5

CREATE INDEX idx_ft_exec_mode_split ON ft_exec_mode_split USING GIN (to_tsvector('simple', content));
CREATE INDEX

-- @normalize explain_search_ids
EXPLAIN
SELECT id
FROM ft_exec_mode_split
WHERE to_tsvector('simple', content) @@ plainto_tsquery('simple', 'vector database');
QUERY PLAN
PROJECTION  (rows=1)
  Output: id
  ->  FULLTEXT_SCAN on public.ft_exec_mode_split  (rows=1)
    Search Definition: <search-definition-id>
    Search Generation: <search-generation-id>
    Search Root: <search-root-id>
    Search Capability: Queryable
    Column: 1
    Mode: Filter

-- @normalize explain_search_ids
EXPLAIN
SELECT id
FROM ft_exec_mode_split
WHERE to_tsvector('simple', content) @@ plainto_tsquery('simple', 'vector database')
ORDER BY ts_rank(
    to_tsvector('simple', content),
    plainto_tsquery('simple', 'vector database')
) DESC
LIMIT 2;
QUERY PLAN
PROJECTION  (rows=1)
  Output: id
  ->  TOP_N  (rows=1)
    Sort Key: #1 DESC NULLS FIRST
    Limit: 2
    ->  PROJECTION  (rows=1)
      Output: id, __paro_hidden_1
      ->  FULLTEXT_SCAN on public.ft_exec_mode_split  (rows=1)
        Search Definition: <search-definition-id>
        Search Generation: <search-generation-id>
        Search Root: <search-root-id>
        Search Capability: Queryable
        Column: 1
        Mode: Filter

SELECT id
FROM ft_exec_mode_split
WHERE to_tsvector('simple', content) @@ plainto_tsquery('simple', 'vector database')
ORDER BY id;
id
1
2
3

DROP INDEX IF EXISTS idx_ft_exec_mode_split;
DROP INDEX

DROP TABLE ft_exec_mode_split;
