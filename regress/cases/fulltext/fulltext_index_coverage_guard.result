CREATE TABLE ft_coverage_guard (id INT, content VARCHAR);
CREATE TABLE

CREATE INDEX idx_ft_coverage_guard ON ft_coverage_guard USING GIN (to_tsvector('simple', content));
CREATE INDEX

INSERT INTO ft_coverage_guard VALUES
    (1, 'vector after index'),
    (2, 'noise');
INSERT 0 2

-- @normalize explain_search_ids
EXPLAIN
SELECT id
FROM ft_coverage_guard
WHERE to_tsvector('simple', content) @@ plainto_tsquery('simple', 'vector')
ORDER BY id;
QUERY PLAN
ORDER_BY  (rows=1)
  Sort Key: id ASC NULLS LAST
  ->  PROJECTION  (rows=1)
    Output: id
    ->  FULLTEXT_SCAN on public.ft_coverage_guard  (rows=1)
      Search Definition: <search-definition-id>
      Search Generation: <search-generation-id>
      Search Root: <search-root-id>
      Search Capability: Queryable
      Search Candidate: full text
      Column: content
      Mode: Filter

-- @normalize explain_search_ids
EXPLAIN
SELECT id
FROM ft_coverage_guard
WHERE to_tsvector('simple', content) @@ plainto_tsquery('simple', 'vector')
ORDER BY ts_rank(
    to_tsvector('simple', content),
    plainto_tsquery('simple', 'vector')
) DESC
LIMIT 5;
QUERY PLAN
PROJECTION  (rows=1)
  Output: id
  ->  TOP_N  (rows=1)
    Sort Key: ts_rank(to_tsvector('simple', public.ft_coverage_guard.content), 'vector') DESC NULLS FIRST
    Limit: 5
    ->  PROJECTION  (rows=1)
      Output: id, ts_rank(to_tsvector('simple', public.ft_coverage_guard.content), 'vector')
      ->  FULLTEXT_SCAN on public.ft_coverage_guard  (rows=1)
        Search Definition: <search-definition-id>
        Search Generation: <search-generation-id>
        Search Root: <search-root-id>
        Search Capability: Queryable
        Search Candidate: full text
        Column: content
        Mode: Filter

SELECT id
FROM ft_coverage_guard
WHERE to_tsvector('simple', content) @@ plainto_tsquery('simple', 'vector')
ORDER BY id;
id
1

DROP INDEX IF EXISTS idx_ft_coverage_guard;
DROP INDEX

DROP TABLE ft_coverage_guard;
DROP TABLE
