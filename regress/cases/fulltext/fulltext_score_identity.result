DELETE FROM score_identity WHERE id = 1;
DELETE 1

SELECT ts_rank(to_tsvector('simple', content),
               plainto_tsquery('simple', 'vector database')) AS score
FROM score_identity
WHERE to_tsvector('simple', content) @@ plainto_tsquery('simple', 'vector database')
