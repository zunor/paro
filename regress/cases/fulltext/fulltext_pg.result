CREATE TABLE ft_docs (
    id INT,
    category VARCHAR,
    title VARCHAR,
    content VARCHAR
);
CREATE TABLE

INSERT INTO ft_docs VALUES
    (1, 'tech', 'Vector Intro', 'vector database vector'),
    (2, 'tech', 'Graph Hybrid', 'vector graph database'),
    (3, 'spam', NULL, 'vector database spam'),
    (4, 'life', 'Travel Note', 'mountain river');
INSERT 0 4

CREATE INDEX idx_ft_docs_fts ON ft_docs USING GIN (to_tsvector('simple', content));
CREATE INDEX

SELECT id
FROM ft_docs
WHERE to_tsvector('simple', content) @@ plainto_tsquery('simple', 'vector database')
ORDER BY id;
id
1
2
3

SELECT id
FROM ft_docs
WHERE to_tsvector('simple', content) @@ to_tsquery('simple', '(vector & database) | graph')
ORDER BY id;
id
1
2
3

SELECT id
FROM ft_docs
WHERE to_tsvector('simple', content) @@ to_tsquery('simple', '!spam')
ORDER BY id;
id
1
2
4

SELECT id
FROM ft_docs
WHERE to_tsvector('simple', content) @@ phraseto_tsquery('simple', 'vector database')
ORDER BY id;
id
1
3

SELECT id
FROM ft_docs
WHERE to_tsvector('simple', content) @@ websearch_to_tsquery('simple', '"vector database" -spam')
ORDER BY id;
id
1

SELECT id
FROM ft_docs
WHERE fulltext_match(content || '', 'vector database') AND category = 'tech';
id
1
2

-- @normalize explain_search_ids
EXPLAIN
SELECT id
FROM ft_docs
WHERE to_tsvector('simple', content) @@ plainto_tsquery('simple', 'vector database')
ORDER BY ts_rank(
    to_tsvector('simple', content),
    plainto_tsquery('simple', 'vector database')
) DESC
LIMIT 2;
QUERY PLAN
PROJECTION  (rows=1)
  Output: id
  ->  TOP_N  (rows=1)
    Sort Key: ts_rank(to_tsvector('simple', public.ft_docs.content), 'vector & database') DESC NULLS FIRST
    Limit: 2
    ->  PROJECTION  (rows=1)
      Output: id, ts_rank(to_tsvector('simple', public.ft_docs.content), 'vector & database')
      ->  FULLTEXT_SCAN on public.ft_docs  (rows=1)
        Search Definition: <search-definition-id>
        Search Generation: <search-generation-id>
        Search Root: <search-root-id>
        Search Capability: Queryable
        Search Candidate: full text
        Column: content
        Mode: Filter

CREATE TABLE ft_rank (id INT, content VARCHAR);
CREATE TABLE

INSERT INTO ft_rank VALUES
    (1, 'vector database vector'),
    (2, 'vector database'),
    (3, 'vector');
INSERT 0 3

SELECT id,
       ts_rank(to_tsvector('simple', content), plainto_tsquery('simple', 'vector database')) AS rank
FROM ft_rank
WHERE to_tsvector('simple', content) @@ plainto_tsquery('simple', 'vector database')
ORDER BY rank DESC, id
LIMIT 2;
id	rank
1	2.375000
2	2.000000

DROP INDEX IF EXISTS idx_ft_docs_fts;
DROP INDEX

DROP TABLE ft_rank;
DROP TABLE

DROP TABLE ft_docs;
DROP TABLE
