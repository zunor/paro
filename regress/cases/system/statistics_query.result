DROP TABLE IF EXISTS stats_small;
DROP TABLE

DROP TABLE IF EXISTS stats_big;
DROP TABLE

CREATE TABLE stats_small (
    id INT PRIMARY KEY,
    payload VARCHAR
);
CREATE TABLE

CREATE TABLE stats_big (
    id INT PRIMARY KEY,
    payload VARCHAR
);
CREATE TABLE

INSERT INTO stats_small VALUES
    (1, 'small');
INSERT 0 1

INSERT INTO stats_big VALUES
    (1, 'alpha'),
    (2, 'beta'),
    (3, 'gamma'),
    (4, 'delta'),
    (5, 'epsilon');
INSERT 0 5

SELECT table_name, estimated_rows
FROM paro_tables()
WHERE table_name IN ('stats_big', 'stats_small')
ORDER BY table_name;
table_name	estimated_rows
stats_big	5
stats_small	1

EXPLAIN (VERBOSE)
SELECT s.id, b.payload
FROM stats_small AS s
JOIN stats_big AS b ON s.id = b.id;
QUERY PLAN
PROJECTION  (rows=1)
  Output: id, payload
  Cardinality: [0, 1, 1]
  Output Schema: s.id INTEGER, b.payload VARCHAR
  ->  FILTER  (rows=1)
        Filter: (id = id)
        Cardinality: [0, 1, 1]
        Output Schema: id INTEGER, payload VARCHAR, id INTEGER
        ->  CROSS_PRODUCT  (rows=5)
              Join Type: CROSS
              Cardinality: [5, 5, 5]
              Output Schema: id INTEGER, payload VARCHAR, id INTEGER
              ->  ROWSET_SCAN on public.stats_big b
                    Columns: id, payload
                    Output Schema: id INTEGER, payload VARCHAR
              ->  ROWSET_SCAN on public.stats_small s
                    Columns: id
                    Output Schema: id INTEGER

SELECT s.id, b.payload
FROM stats_small AS s
JOIN stats_big AS b ON s.id = b.id
ORDER BY s.id;
s.id	b.payload
1	alpha

