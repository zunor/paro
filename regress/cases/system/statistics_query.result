    (1, 'alpha'),
    (2, 'beta'),
    (3, 'gamma'),
    (4, 'delta'),
    (5, 'epsilon');
INSERT 0 5

SELECT table_name, estimated_rows
FROM paro_tables()
WHERE table_name IN ('stats_big', 'stats_small')
ORDER BY table_name;
table_name	estimated_rows
stats_big	5
stats_small	1

EXPLAIN (VERBOSE)
SELECT s.id, b.payload
FROM stats_small AS s
JOIN stats_big AS b ON s.id = b.id;
QUERY PLAN
PROJECTION  (rows=1)
  Output: s.id, b.payload
  Cardinality: [1, 1, 1]
  Output Schema: "s.id" INTEGER, "b.payload" VARCHAR
  ->  HASH_JOIN  (rows=1)
    Join Type: INNER
    Build Index: integer_build_time
    Join Condition: b.id = s.id
    Cardinality: [1, 1, 1]
    Output Schema: b.payload VARCHAR, s.id INTEGER
    ->  ROWSET_SCAN on public.stats_big b
      Columns: id, payload
      Pushed Predicate: id <= 1 AND id = 1
      Late Materialize: auto
      Runtime Filter: id = 1
      Output Schema: b.id INTEGER, b.payload VARCHAR
    ->  ROWSET_SCAN on public.stats_small s  (rows=1)
      Columns: id
      Cardinality: [1, 1, 1]
      Output Schema: s.id INTEGER

SELECT s.id, b.payload
FROM stats_small AS s
JOIN stats_big AS b ON s.id = b.id
ORDER BY s.id;
s.id	b.payload
1	alpha

