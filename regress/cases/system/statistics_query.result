DROP TABLE IF EXISTS stats_small;
DROP TABLE

DROP TABLE IF EXISTS stats_big;
DROP TABLE

CREATE TABLE stats_small (
    id INT PRIMARY KEY,
    payload VARCHAR
);
CREATE TABLE

CREATE TABLE stats_big (
    id INT PRIMARY KEY,
    payload VARCHAR
);
CREATE TABLE

INSERT INTO stats_small VALUES
    (1, 'small');
INSERT 0 1

