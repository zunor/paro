INSERT INTO spill_h_sort
SELECT g, g
FROM generate_series(1, 10000) AS t(g);
INSERT 0 10000

INSERT INTO spill_h_agg
SELECT g, g % 257, 1
FROM generate_series(1, 200000) AS t(g);
INSERT 0 200000

INSERT INTO spill_h_join_l
SELECT g
FROM generate_series(1, 1000) AS t(g);
INSERT 0 1000

INSERT INTO spill_h_join_r
SELECT g
FROM generate_series(1, 1000) AS t(g);
INSERT 0 1000

SET temp_directory = '/tmp/paro_regress_spill_h';
SET

SET force_external = true;
SET

-- @normalize explain_operator_timing,explain_summary_timing,explain_runtime_bytes
EXPLAIN ANALYZE SELECT id FROM spill_h_sort ORDER BY id DESC;
QUERY PLAN
PIPELINE 0
  SOURCE #0 ROWSET_SCAN (actual time=<time-range> rows=10000 loops=4)
  TRANSFORM #1 PROJECTION (actual time=<time-range> rows=10000 loops=3)
  SINK #2 SORT_BUILD (actual time=<time-range> rows=10000 loops=3 spilled=true peak_memory_bytes=303095 spilled_bytes=886405)
PIPELINE 1
  SOURCE #3 SORT_EMIT (actual time=<time-range> rows=10000 loops=6)
  TRANSFORM #4 PROJECTION (actual time=<time-range> rows=10000 loops=5)
  SINK #5 CLIENT_RESULT (actual time=<time-range> rows=10000 loops=5)
Execution Time: <time-ms>
Rows Returned: 10000

