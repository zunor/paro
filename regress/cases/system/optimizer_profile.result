SELECT 1;
1
1

SELECT count(*) > 0 AS has_rows FROM paro_optimizers();
has_rows
true

SELECT name, kind
FROM paro_optimizers()
WHERE name IN ('semantic_normalization', 'memo_exploration', 'winner_verification')
ORDER BY name;
name	kind
memo_exploration	search
semantic_normalization	frontend
winner_verification	verification

SELECT count(*) > 0 AS has_invocations
FROM paro_optimizers()
WHERE invocation_count > 0;
has_invocations
true

SELECT count(*) > 0 AS has_nonnegative_elapsed
FROM paro_optimizers()
WHERE last_elapsed_us >= 0;
has_nonnegative_elapsed
true
